      style={{ borderRadius:12,overflow:'hidden',cursor:'pointer',border:selected?`2px solid ${t.accent}`:'1px solid var(--line)',boxShadow:selected?`0 0 0 3px ${t.accent}22,0 8px 20px ${t.accent}18`:hovered?'0 8px 24px rgba(0,0,0,0.10)':'0 2px 6px rgba(0,0,0,0.04)',transform:hovered&&!selected?'translateY(-2px)':'none',transition:'all 180ms cubic-bezier(.4,0,.2,1)',background:'var(--bg)',position:'relative' }}>
      {selected&&<div style={{position:'absolute',top:10,right:10,zIndex:10,width:22,height:22,borderRadius:'50%',background:t.accent,display:'flex',alignItems:'center',justifyContent:'center',boxShadow:`0 2px 8px ${t.accent}60`}}><svg width="11" height="11" viewBox="0 0 11 11" fill="none"><polyline points="2,5.5 4.5,8.5 9,2.5" stroke="#fff" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/></svg></div>}
