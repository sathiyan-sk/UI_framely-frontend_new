// ─── Main ─────────────────────────────────────────────────────────────────────
export default function CreateEvent() {
  const router = useRouter()
  const [step, setStep] = useState(1)
  const [creating, setCreating] = useState(false)
  const [errors, setErrors] = useState({})
  const [reelAI, setReelAI] = useState(false)
  const [branding, setBranding] = useState(false)
  const [photoSelling, setPhotoSelling] = useState(false)
  const [templateCategory, setTemplateCategory] = useState('wedding')
  const [selectedTemplate, setSelectedTemplate] = useState('lavender_dream')

  const [form, setForm] = useState({
    name: '', start_date: new Date().toISOString().split('T')[0],
    end_date: new Date().toISOString().split('T')[0],
    event_type: '', location: '', description: '',
  })

  function set(k, v) {
    setForm(p => ({ ...p, [k]: v }))
    if (errors[k]) setErrors(p => ({ ...p, [k]: '' }))
  }

  function validate() {
    const e = {}
    if (!form.name.trim()) e.name = 'Give your event a name.'
    if (!form.event_type) e.event_type = 'Pick an event type.'
    if (form.start_date && form.end_date && form.end_date < form.start_date) e.end_date = "End date can't be before the start."
    setErrors(e)
    return Object.keys(e).length === 0
  }

  async function handleCreate() {
    if (!validate()) return
    setCreating(true)
    const token = localStorage.getItem('token')
    try {
      const res = await fetch(`${API_URL}/events/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ ...form, gallery_template: selectedTemplate }),
      })
      const data = await res.json()
      if (data.id) router.push(`/dashboard/events/${data.id}`)
    } catch (e) { console.error(e) }
    setCreating(false)
  }

  const currentCat = TEMPLATE_CATEGORIES.find(c => c.id === templateCategory)

  return (
    <div className="ce-root">
      <style>{css}</style>

      {/* Sticky topbar */}
      <div style={{ position:'sticky',top:0,zIndex:20,background:'rgba(250,249,247,0.9)',backdropFilter:'blur(14px)',borderBottom:'1px solid var(--line-soft)',padding:'0 44px' }}>
        <div style={{ maxWidth:860,margin:'0 auto',height:54,display:'flex',alignItems:'center',justifyContent:'space-between' }}>
          <div style={{ display:'flex',alignItems:'center',gap:8,fontSize:13,color:'var(--ink-mute)' }}>
            <button onClick={()=>router.push('/dashboard/events')} style={{ background:'none',border:'none',cursor:'pointer',color:'var(--ink-mute)',fontSize:13,padding:0,fontFamily:'var(--sans)' }}>Events</button>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3l3 3-3 3" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/></svg>
            <span style={{ color:'var(--ink)',fontWeight:500 }}>Create event</span>
          </div>
          <div style={{ display:'flex',gap:8,alignItems:'center' }}>
            <span style={{ fontFamily:'var(--mono)',fontSize:11,color:'var(--ink-mute)' }}>Step {step} of 2</span>
            <div style={{ width:1,height:14,background:'var(--line)' }}/>
            <button className="ce-btn ce-btn-outline" style={{ fontSize:12,padding:'5px 12px' }}>Save draft</button>
          </div>
        </div>
      </div>

      <div style={{ maxWidth:860,margin:'0 auto',padding:'40px 44px 80px' }}>

        {/* Page heading */}
        <div style={{ marginBottom:36 }}>
          <div style={{ fontFamily:'var(--mono)',fontSize:11,color:'var(--ink-mute)',textTransform:'uppercase',letterSpacing:'0.12em',marginBottom:10 }}>
            New event · Step {step} of 2
          </div>
          <h1 style={{ fontFamily:'var(--serif)',fontSize:44,fontWeight:400,letterSpacing:'-0.02em',margin:'0 0 10px',lineHeight:1.05 }}>
            {step===1?<>Let's create something <em style={{fontStyle:'italic'}}>memorable</em>.</>:<>Choose your <em style={{fontStyle:'italic'}}>gallery design</em>.</>}
          </h1>
          <p style={{ fontSize:14.5,color:'var(--ink-mute)',maxWidth:520,lineHeight:1.55,margin:0 }}>
            {step===1?"Start with the essentials. You'll choose a gallery design next, then go live.":'How your guests will experience the photo gallery. You can change this later.'}
          </p>
        </div>

        <Stepper step={step}/>

        {/* ── STEP 1 ── */}
        {step===1&&(
          <div className="fade-up">

            {/* Name */}
            <div style={{ position:'relative',marginBottom:4 }}>
              <div style={{ fontFamily:'var(--mono)',fontSize:11,color:'var(--ink-mute)',textTransform:'uppercase',letterSpacing:'0.09em',marginBottom:10 }}>01 — Event name</div>
              <input className="ce-name-input" placeholder="e.g. Sarah & James · Wedding Weekend" value={form.name} onChange={e=>set('name',e.target.value)} maxLength={80}/>
              <span style={{ position:'absolute',right:0,bottom:14,fontFamily:'var(--mono)',fontSize:11,color:'var(--ink-mute)' }}>{form.name.length}/80</span>
            </div>
            {errors.name&&<div className="ce-error">⚠ {errors.name}</div>}

            {/* Schedule */}
            <div className="ce-section">
              <div className="ce-section-head"><h3 className="ce-section-title">Schedule</h3><span className="ce-section-num">02</span></div>
              <p style={{ fontSize:12.5,color:'var(--ink-mute)',margin:'0 0 16px',lineHeight:1.5 }}>Guests can upload and view photos only between these dates.</p>
              <div style={{ display:'grid',gridTemplateColumns:'1fr 1fr',gap:14 }}>
                <div>
                  <label className="ce-label">Start date</label>
                  <input className="ce-input" type="date" value={form.start_date} onChange={e=>set('start_date',e.target.value)}/>
                </div>
                <div>
                  <label className="ce-label">End date</label>
                  <input className={`ce-input${errors.end_date?' error':''}`} type="date" value={form.end_date} onChange={e=>set('end_date',e.target.value)}/>
                  {errors.end_date&&<div className="ce-error">⚠ {errors.end_date}</div>}
                  <div style={{ fontSize:11.5,color:'#b45309',marginTop:6,display:'flex',alignItems:'center',gap:5 }}>
                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M5.5 1.5v4M5.5 7.5v.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" strokeWidth="1"/></svg>
                    Photos deleted after end date
                  </div>
                </div>
              </div>
            </div>

            {/* Type & place */}
            <div className="ce-section">
              <div className="ce-section-head"><h3 className="ce-section-title">Type & place</h3><span className="ce-section-num">03</span></div>
              <div style={{ display:'grid',gridTemplateColumns:'1fr 1fr',gap:14,marginBottom:14 }}>
                <div>
                  <label className="ce-label">Event type</label>
                  <select className={`ce-input ce-select${errors.event_type?' error':''}`} value={form.event_type} onChange={e=>set('event_type',e.target.value)}>
                    <option value="">Select a type</option>
                    {EVENT_TYPES.map(t=><option key={t} value={t}>{t}</option>)}
                  </select>
                  {errors.event_type&&<div className="ce-error">⚠ {errors.event_type}</div>}
                </div>
                <div>
                  <label className="ce-label">Location — <span style={{fontWeight:400,textTransform:'none',letterSpacing:0}}>optional</span></label>
                  <input className="ce-input" placeholder="e.g. Villa Balbiano, Lake Como" value={form.location} onChange={e=>set('location',e.target.value)}/>
                </div>
              </div>
              <div>
                <label className="ce-label">Description — <span style={{fontWeight:400,textTransform:'none',letterSpacing:0}}>optional</span></label>
                <textarea className="ce-input ce-textarea" placeholder="A welcome note for guests — dress code, schedule, etc." value={form.description} onChange={e=>set('description',e.target.value)}/>
              </div>
            </div>

            {/* Add-ons */}
            <div className="ce-section">
              <div className="ce-section-head"><h3 className="ce-section-title">Add-ons</h3><span className="ce-section-num">04</span></div>
              <p style={{ fontSize:12.5,color:'var(--ink-mute)',margin:'0 0 4px',lineHeight:1.5 }}>Optional — change these any time.</p>

              <div className="ce-addon">
                <div className="ce-addon-icon">🛒</div>
                <div style={{flex:1}}>
                  <div className="ce-addon-title">Photo sales <span className="ce-tag" style={{background:'var(--ink)',color:'var(--bg)'}}>PRO</span></div>
                  <div className="ce-addon-desc">Let guests purchase prints and digital downloads. You keep 85%.</div>
                  <a style={{fontSize:12,color:'var(--ink-mute)',marginTop:6,display:'inline-flex',alignItems:'center',gap:4,cursor:'pointer',textDecoration:'underline',textDecorationColor:'var(--line)',textUnderlineOffset:3}}>Requires Pro plan — learn more →</a>
                </div>
                <Toggle on={photoSelling} onChange={()=>setPhotoSelling(p=>!p)}/>
              </div>

              <div className="ce-addon">
                <div className="ce-addon-icon">🎬</div>
                <div style={{flex:1}}>
                  <div className="ce-addon-title">Reel AI <span className="ce-tag" style={{background:'var(--accent-bg)',color:'var(--accent)'}}>NEW</span></div>
                  <div className="ce-addon-desc">Auto-generate a short highlight reel for each guest, delivered the morning after.</div>
                </div>
                <Toggle on={reelAI} onChange={()=>setReelAI(p=>!p)}/>
              </div>

              <div className="ce-addon">
                <div className="ce-addon-icon">🎨</div>
                <div style={{flex:1}}>
                  <div className="ce-addon-title">Event branding</div>
                  <div className="ce-addon-desc">Apply your logo, colors, and custom domain to the guest gallery.</div>
                  {branding&&(
                    <div style={{marginTop:14,padding:16,border:'1px solid var(--line-soft)',borderRadius:10,background:'var(--bg-soft)',textAlign:'center'}}>
                      <div style={{fontSize:14,fontWeight:500,marginBottom:4}}>No brand kit yet</div>
                      <div style={{fontSize:12.5,color:'var(--ink-mute)',marginBottom:12}}>Create a brand kit to apply your logo and colors</div>
                      <button className="ce-btn ce-btn-primary" style={{fontSize:12,padding:'7px 16px'}}>Add brand kit</button>
                    </div>
                  )}
                </div>
                <Toggle on={branding} onChange={()=>setBranding(p=>!p)}/>
              </div>
            </div>

            {/* Footer */}
            <div style={{ display:'flex',alignItems:'center',justifyContent:'space-between',marginTop:36,paddingTop:22,borderTop:'1px solid var(--line-soft)' }}>
              <div style={{ fontFamily:'var(--mono)',fontSize:11.5,color:'var(--ink-mute)',display:'flex',alignItems:'center',gap:6 }}>
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><rect x="1" y="3" width="9" height="7" rx="1.5" stroke="currentColor" strokeWidth="1.2"/><path d="M3.5 3V2.5a2 2 0 014 0V3" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round"/></svg>
                Draft autosaved
              </div>
              <div style={{display:'flex',gap:10}}>
                <button className="ce-btn ce-btn-outline" onClick={()=>router.push('/dashboard/events')}>Cancel</button>
                <button className="ce-btn ce-btn-primary" onClick={()=>{if(validate())setStep(2)}}>
                  Continue to design <ChevR/>
                </button>
              </div>
            </div>
          </div>
        )}

        {/* ── STEP 2 ── */}
        {step===2&&(
          <div className="fade-up">

            {/* Summary strip */}
            <div style={{ border:'1px solid var(--line)',borderRadius:12,padding:'16px 20px',marginBottom:28,background:'var(--bg-soft)',display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(130px,1fr))',gap:12,alignItems:'center' }}>
              {[['Event',form.name],['Type',form.event_type],['Start',form.start_date],['End',form.end_date],['Location',form.location||'—']].map(([k,v])=>(
                <div key={k}><div style={{fontFamily:'var(--mono)',fontSize:10,color:'var(--ink-mute)',textTransform:'uppercase',letterSpacing:'0.08em',marginBottom:3}}>{k}</div><div style={{fontSize:13,fontWeight:500,color:'var(--ink)',wordBreak:'break-word'}}>{v}</div></div>
              ))}
              <button className="ce-btn ce-btn-outline" style={{fontSize:11.5,padding:'5px 11px',justifySelf:'start'}} onClick={()=>setStep(1)}>← Edit</button>
            </div>

            {/* Category tabs */}
            <div className="cat-tabs" style={{marginBottom:20}}>
              {TEMPLATE_CATEGORIES.map(cat=>(
                <button key={cat.id} className={`cat-tab${templateCategory===cat.id?' active':''}`} onClick={()=>setTemplateCategory(cat.id)}>{cat.label}</button>
              ))}
            </div>

            {/* Template grid */}
            <div style={{ display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(210px,1fr))',gap:16,marginBottom:20 }}>
              {currentCat?.templates.map(t=>(
                <TemplateCard key={t.id} t={t} selected={selectedTemplate===t.id} onClick={setSelectedTemplate}/>
              ))}
            </div>

            {/* Selected callout */}
            {selectedTemplate&&(()=>{
              const sel=currentCat?.templates.find(t=>t.id===selectedTemplate)
              return sel?(
                <div style={{padding:'10px 16px',borderRadius:8,background:'var(--bg-soft)',border:'1px solid var(--line)',display:'flex',alignItems:'center',gap:10,marginBottom:28}}>
                  <div style={{width:8,height:8,borderRadius:'50%',background:sel.accent,flexShrink:0}}/>
                  <span style={{fontSize:13,fontWeight:500}}>Selected: <strong>{sel.name}</strong></span>
                  <span style={{fontSize:12,color:'var(--ink-mute)',marginLeft:'auto'}}>Changeable in event settings</span>
                </div>
              ):null
            })()}

            {/* Footer */}
            <div style={{ display:'flex',justifyContent:'space-between',paddingTop:22,borderTop:'1px solid var(--line-soft)' }}>
              <button className="ce-btn ce-btn-outline" onClick={()=>setStep(1)}><ChevL/> Back</button>
              <button className="ce-btn ce-btn-primary" onClick={handleCreate} disabled={creating} style={{minWidth:150,justifyContent:'center'}}>
                {creating?<><span className="spinner"/> Creating…</>:'🎉 Create event'}
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
