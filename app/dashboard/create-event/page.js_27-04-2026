  .ce-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 20px; border-radius:8px; border:none; font-family:var(--sans); font-size:13.5px; font-weight:600; cursor:pointer; transition:all 140ms; white-space:nowrap; }
  .ce-btn-primary { background:var(--ink); color:var(--bg); }
  .ce-btn-primary:hover { background:var(--ink-soft); }
  .ce-btn-primary:disabled { opacity:0.5; cursor:not-allowed; }
  .ce-btn-outline { background:var(--bg); color:var(--ink-soft); border:1px solid var(--line); }
