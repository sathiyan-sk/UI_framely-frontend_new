// ─── PosterBanner ─────────────────────────────────────────────────────────────
function PosterBanner({ t }) {
  const p = t.poster
  const isDark = p.dark !== false

  return (
    <div style={{ position: 'relative', width: '100%', height: 170, background: p.bg, overflow: 'hidden', flexShrink: 0 }}>
      {p.overlayShape === 'arch' && (
        <svg style={{ position: 'absolute', bottom: -10, left: 0, right: 0, width: '100%' }} viewBox="0 0 200 60" preserveAspectRatio="none">
          <ellipse cx="100" cy="60" rx="110" ry="50" fill="rgba(255,255,255,0.06)" />
        </svg>
      )}
      {p.overlayShape === 'mandala' && (
        <svg style={{ position: 'absolute', right: -20, top: -20, opacity: 0.15, width: 100, height: 100 }} viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="48" fill="none" stroke="#fff" strokeWidth="1"/>
          <circle cx="50" cy="50" r="36" fill="none" stroke="#fff" strokeWidth="1"/>
          <circle cx="50" cy="50" r="24" fill="none" stroke="#fff" strokeWidth="1"/>
          {[0,45,90,135,180,225,270,315].map(a => (
            <line key={a} x1="50" y1="50" x2={50+48*Math.cos(a*Math.PI/180)} y2={50+48*Math.sin(a*Math.PI/180)} stroke="#fff" strokeWidth="0.5"/>
          ))}
        </svg>
      )}
      {p.overlayShape === 'wave' && (
        <svg style={{ position: 'absolute', bottom: 0, left: 0, right: 0, width: '100%', opacity: 0.2 }} viewBox="0 0 200 30" preserveAspectRatio="none">
          <path d="M0,15 C50,0 150,30 200,15 L200,30 L0,30 Z" fill="#fff"/>
        </svg>
      )}
      {p.overlayShape === 'geo' && (
        <svg style={{ position: 'absolute', top: 0, right: 0, opacity: 0.12, width: 80, height: 80 }} viewBox="0 0 80 80">
          <polygon points="80,0 80,80 0,80" fill="#fff"/>
          <polygon points="80,0 80,50 30,0" fill="rgba(255,255,255,0.3)"/>
        </svg>
      )}
      {p.overlayShape === 'speed' && (
        <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', opacity: 0.1 }} viewBox="0 0 200 170" preserveAspectRatio="none">
          {[0,30,60,90,120].map(x => (
            <line key={x} x1={x} y1="0" x2={x+40} y2="170" stroke="#fff" strokeWidth="6"/>
          ))}
        </svg>
      )}
      {p.overlayShape === 'glow' && (
        <div style={{ position: 'absolute', inset: 0, background: `radial-gradient(ellipse at 70% 30%, ${t.accent}60 0%, transparent 65%)`, pointerEvents: 'none' }} />
      )}
      {p.overlayShape === 'sunset' && (
        <svg style={{ position: 'absolute', bottom: 0, left: 0, right: 0, width: '100%', opacity: 0.3 }} viewBox="0 0 200 60" preserveAspectRatio="none">
          <ellipse cx="100" cy="60" rx="120" ry="55" fill="#f97316"/>
        </svg>
      )}
      {p.overlayShape === 'bloom' && (
        <svg style={{ position: 'absolute', right: 8, top: 8, opacity: 0.18, width: 60, height: 60 }} viewBox="0 0 60 60">
          {[0,60,120,180,240,300].map(a => (
            <ellipse key={a} cx="30" cy="30" rx="8" ry="22"
              transform={`rotate(${a} 30 30)`} fill="#fff"/>
          ))}
          <circle cx="30" cy="30" r="6" fill="#fff"/>
        </svg>
      )}
      {p.overlayShape === 'columns' && (
        <svg style={{ position: 'absolute', bottom: 0, left: 10, opacity: 0.12, width: 80, height: 60 }} viewBox="0 0 80 60">
          {[0,20,40,60].map(x => <rect key={x} x={x} y="10" width="12" height="50" rx="6" fill="#fff"/>)}
        </svg>
      )}
      {p.overlayShape === 'bars' && (
        <svg style={{ position: 'absolute', right: 0, top: 0, opacity: 0.1, width: 70, height: 170 }} viewBox="0 0 70 170" preserveAspectRatio="none">
          {[0,18,36,54].map(x => <rect key={x} x={x} y="0" width="10" height="170" fill="#fff"/>)}
        </svg>
      )}
      {p.overlayShape === 'grid' && (
        <svg style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', opacity: 0.06 }} viewBox="0 0 200 170" preserveAspectRatio="none">
          {[20,40,60,80,100,120,140,160,180].map(x => <line key={'v'+x} x1={x} y1="0" x2={x} y2="170" stroke="#fff" strokeWidth="1"/>)}
          {[20,40,60,80,100,120,140,160].map(y => <line key={'h'+y} x1="0" y1={y} x2="200" y2={y} stroke="#fff" strokeWidth="1"/>)}
        </svg>
      )}

      <div style={{
        position: 'absolute', top: 12, left: 0, right: 0, textAlign: 'center',
        fontSize: 7, fontWeight: 800, letterSpacing: '.12em',
        color: isDark ? 'rgba(255,255,255,0.65)' : 'rgba(0,0,0,0.4)',
        fontFamily: 'system-ui,sans-serif',
      }}>
        {p.eyebrow}
      </div>

      <div style={{
        position: 'absolute', top: '50%', left: 0, right: 0,
        transform: 'translateY(-52%)', textAlign: 'center',
        fontFamily: p.titleFont === 'serif' ? 'Georgia,serif' : 'system-ui,sans-serif',
      }}>
        <div style={{
          fontSize: p.titleFont === 'serif' ? 20 : 16, fontWeight: p.titleFont === 'serif' ? 400 : 900,
          color: isDark ? '#fff' : '#1e293b', lineHeight: 1.15,
          letterSpacing: p.titleFont === 'sans' ? '.04em' : 'normal',
        }}>
          {p.titleLine1}
        </div>
        {p.titleLine2 && (
          <div style={{
            fontSize: p.titleFont === 'serif' ? 13 : 14, fontWeight: p.titleFont === 'serif' ? 400 : 800,
            color: isDark ? 'rgba(255,255,255,0.75)' : '#475569',
            marginTop: p.titleFont === 'serif' ? 1 : 2,
            letterSpacing: p.titleFont === 'sans' ? '.06em' : 'normal',
            fontFamily: p.titleFont === 'serif' ? 'Georgia,serif' : 'system-ui,sans-serif',
          }}>
            {p.titleFont === 'serif' ? '& ' : ''}{p.titleLine2}
          </div>
        )}
      </div>

      <div style={{ position: 'absolute', bottom: 12, left: 0, right: 0, display: 'flex', justifyContent: 'center' }}>
        <div style={{
          background: isDark ? 'rgba(255,255,255,0.15)' : 'rgba(0,0,0,0.08)',
          backdropFilter: 'blur(4px)', borderRadius: 20, padding: '3px 10px',
          fontSize: 7.5, fontWeight: 600,
          color: isDark ? 'rgba(255,255,255,0.8)' : '#475569',
          fontFamily: 'system-ui,sans-serif', letterSpacing: '.04em',
        }}>
          {p.date}
        </div>
      </div>
    </div>
  )
}

