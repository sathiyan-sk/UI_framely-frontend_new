  const [templateCategory, setTemplateCategory] = useState('wedding')
  const [selectedTemplate, setSelectedTemplate]  = useState('lavender_dream')

  const today = todayStr()

  const [form, setForm] = useState({
    name:        '',
    start_date:  today,
    end_date:    today,
    event_type:  '',
    location:    '',
    description: '',
  })

  function set(k, v) {
    setForm(prev => {
      const updated = { ...prev, [k]: v }

      // Auto-correct: if start_date is pushed past end_date, bump end_date
      if (k === 'start_date' && v > updated.end_date) {
        updated.end_date = v
      }

      // Auto-correct: if end_date is pulled before start_date, bump start_date
      if (k === 'end_date' && v < updated.start_date) {
        updated.start_date = v
      }

      return updated
    })
    if (errors[k]) setErrors(p => ({ ...p, [k]: '' }))
  }

  function validate() {
    const e = {}
    if (!form.name.trim())      e.name       = 'Event name is required'
    if (!form.event_type)       e.event_type = 'Event type is required'
    if (form.start_date < today) e.start_date = 'Start date cannot be in the past'
    if (form.end_date < form.start_date) e.end_date = 'End date cannot be before start date'
    setErrors(e)
    return Object.keys(e).length === 0
  }

