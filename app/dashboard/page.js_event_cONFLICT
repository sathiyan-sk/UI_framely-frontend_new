// ─── LayoutPreview ────────────────────────────────────────────────────────────
function LayoutPreview({ t }) {
  const p = t.palette
  const gap = 3

  if (t.layout === 'grid') {
    const cells = [
      {c:p[0],s:0},{c:p[2],s:2},{c:p[1],s:4},{c:p[3],s:1},
      {c:p[2],s:3},{c:p[0],s:0},{c:p[3],s:2},{c:p[1],s:4},
      {c:p[1],s:1},{c:p[3],s:3},{c:p[0],s:2},{c:p[2],s:0},
    ]
    return (
      <div style={{ padding: gap, background: '#f9fafb', display: 'grid', gridTemplateColumns: 'repeat(4,1fr)', gap }}>
        {cells.map((cell,i) => (
          <PhotoCell key={i} color={cell.c} h={22} scene={cell.s} r={3} style={{ width: '100%' }}/>
        ))}
      </div>
    )
  }

  if (t.layout === 'masonry') {
    const cols = [
      [{c:p[2],h:36,s:0},{c:p[0],h:24,s:3},{c:p[3],h:28,s:1}],
      [{c:p[1],h:26,s:2},{c:p[3],h:38,s:4},{c:p[0],h:22,s:0}],
      [{c:p[4],h:30,s:1},{c:p[1],h:24,s:3},{c:p[2],h:34,s:2}],
    ]
    return (
      <div style={{ padding: gap, background: '#f9fafb', display: 'flex', gap }}>
        {cols.map((col, ci) => (
          <div key={ci} style={{ flex: 1, display: 'flex', flexDirection: 'column', gap }}>
            {col.map((cell, ri) => (
              <PhotoCell key={ri} color={cell.c} h={cell.h} scene={cell.s} r={3} style={{ width: '100%' }}/>
            ))}
          </div>
        ))}
      </div>
    )
  }

  if (t.layout === 'featured') {
    return (
      <div style={{ padding: gap, background: '#f9fafb', display: 'flex', flexDirection: 'column', gap }}>
        <div style={{ display: 'flex', gap, height: 62 }}>
          <PhotoCell color={p[3]} scene={2} r={4} style={{ flex: 2, height: '100%' }}/>
          <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap }}>
            <PhotoCell color={p[1]} scene={0} r={3} style={{ flex: 1, width: '100%' }}/>
            <PhotoCell color={p[0]} scene={4} r={3} style={{ flex: 1, width: '100%' }}/>
          </div>
        </div>
        <div style={{ display: 'flex', gap, height: 20 }}>
