'use client'
import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import Link from 'next/link'

const API_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000'

const eventColors = [
  'linear-gradient(135deg,#9b7fe8,#c084fc)',
  'linear-gradient(135deg,#f472b6,#ec4899)',
  'linear-gradient(135deg,#60a5fa,#3b82f6)',
  'linear-gradient(135deg,#34d399,#10b981)',
  'linear-gradient(135deg,#fbbf24,#f59e0b)',
  'linear-gradient(135deg,#a78bfa,#8b5cf6)',
]

const styles = `
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&display=swap');

  .events-root {
    --serif:  'DM Serif Display', Georgia, serif;
    --mono:   'DM Mono', monospace;
    --sans:   'DM Sans', sans-serif;

    --bg:         #faf9f7;
    --bg-soft:    #f2f0ec;
    --bg-sunk:    #e8e4dd;
    --ink:        #1a1714;
    --ink-soft:   #4a453f;
    --ink-mute:   #8c8680;
    --line:       #e0dbd3;
    --line-soft:  #ede9e2;
    --accent:     #2563eb;
    --accent-bg:  #eff6ff;
    --danger:     #dc2626;
    --danger-bg:  #fef2f2;
    --success:    #16a34a;
    --success-bg: #f0fdf4;

    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
  }

  .events-root * { box-sizing: border-box; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 18px; border-radius: 8px;
    font-family: var(--sans); font-size: 13px; font-weight: 600;
    cursor: pointer; transition: all 140ms; border: none; text-decoration: none;
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--ink); color: var(--bg);
  }
  .btn-primary:hover { background: var(--ink-soft); }

  .btn-outline {
    background: transparent; color: var(--ink-soft);
    border: 1px solid var(--line);
  }
  .btn-outline:hover { background: var(--bg-soft); border-color: var(--ink-mute); }

  .btn-danger {
    background: var(--danger-bg); color: var(--danger);
    border: 1px solid rgba(220,38,38,0.2);
  }
  .btn-danger:hover { background: #fee2e2; }

  /* Filter tabs */
  .filter-tabs {
    display: flex; gap: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
  }
  .filter-tab {
    padding: 8px 16px;
    font-family: var(--sans); font-size: 12.5px; font-weight: 500;
    color: var(--ink-mute); background: transparent;
    border: none; border-right: 1px solid var(--line);
    cursor: pointer; transition: all 120ms;
    display: flex; align-items: center; gap: 7px;
    white-space: nowrap;
  }
  .filter-tab:last-child { border-right: none; }
  .filter-tab:hover { background: var(--bg-soft); color: var(--ink-soft); }
  .filter-tab.active { background: var(--ink); color: var(--bg); }
  .filter-tab .badge {
    font-size: 10px; font-weight: 600; font-family: var(--mono);
    padding: 1px 6px; border-radius: 20px;
    background: rgba(255,255,255,0.15); color: inherit;
    opacity: 0.8;
  }
  .filter-tab:not(.active) .badge {
    background: var(--bg-sunk); color: var(--ink-mute);
  }

  /* Event card */
  .event-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    overflow: hidden;
    transition: box-shadow 180ms, transform 180ms;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .event-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.10);
    transform: translateY(-2px);
  }

  .event-cover {
    height: 130px; position: relative; overflow: hidden;
  }
  .event-cover img {
    width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.88;
  }

  .event-status-badge {
    position: absolute; top: 10px; right: 10px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 3px 9px; border-radius: 4px;
    backdrop-filter: blur(6px);
  }

  .event-body {
    padding: 16px 18px 14px;
  }
  .event-name {
    font-family: var(--serif); font-size: 20px; font-weight: 400;
    letter-spacing: -0.01em; margin: 0 0 3px; color: var(--ink);
    line-height: 1.2;
  }
  .event-slug {
    font-family: var(--mono); font-size: 11px; color: var(--ink-mute);
    margin-bottom: 12px;
  }

  .feature-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
  .feature-badge {
    font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 20px;
    letter-spacing: 0.03em;
  }

  /* Publish toggle */
  .publish-toggle {
    width: 100%; padding: 8px 0;
    border-radius: 8px; font-size: 11.5px; font-weight: 600;
    cursor: pointer; transition: all 160ms;
    font-family: var(--sans); text-align: center;
  }

  /* Delete button */
  .delete-btn {
    position: absolute; top: 10px; left: 10px;
    width: 26px; height: 26px; border-radius: 6px;
    background: rgba(250,249,247,0.88); border: 1px solid var(--line);
    color: var(--ink-mute); font-size: 11px; font-weight: 700;
    cursor: pointer; display: grid; place-items: center;
    backdrop-filter: blur(4px); transition: all 120ms;
    opacity: 0;
  }
  .event-card:hover .delete-btn { opacity: 1; }
  .delete-btn:hover { background: var(--danger-bg); color: var(--danger); border-color: rgba(220,38,38,0.2); }

  /* Empty state */
  .empty-state {
    border: 1px dashed var(--line);
    border-radius: 16px; padding: 60px 40px;
    text-align: center; grid-column: 1 / -1;
  }

  /* Modal */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(26,23,20,0.4); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    z-index: 50;
  }
  .modal {
    background: var(--bg); border: 1px solid var(--line);
    border-radius: 16px; padding: 32px;
    max-width: 380px; width: 90%;
    box-shadow: 0 24px 64px rgba(0,0,0,0.18);
  }

  /* Cover set badge */
  .cover-badge {
    position: absolute; bottom: 8px; left: 8px;
    background: rgba(26,23,20,0.6); color: #faf9f7;
    font-size: 9px; font-weight: 600; padding: 2px 7px; border-radius: 20px;
    backdrop-filter: blur(4px); letter-spacing: 0.04em;
  }
  .expired-bar {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: rgba(220,38,38,0.82); color: #fff;
    font-size: 10px; font-weight: 700; text-align: center;
    padding: 3px 0; letter-spacing: 0.06em; text-transform: uppercase;
  }
`

export default function EventsPage() {
  const router = useRouter()
  const [events, setEvents] = useState([])
  const [loading, setLoading] = useState(true)
  const [filter, setFilter] = useState('all')
  const [confirmDelete, setConfirmDelete] = useState(null)
  const [deletingId, setDeletingId] = useState(null)
  const [togglingId, setTogglingId] = useState(null)

  useEffect(() => { loadEvents() }, [])

  async function loadEvents() {
    const token = localStorage.getItem('token')
    const res = await fetch(`${API_URL}/events/`, {
      headers: { Authorization: `Bearer ${token}` }
    })
    const data = await res.json()
    if (Array.isArray(data)) setEvents(data)
    setLoading(false)
  }

  async function togglePublish(ev, e) {
    e.preventDefault(); e.stopPropagation()
    setTogglingId(ev.id)
    const token = localStorage.getItem('token')
    try {
      const res = await fetch(`${API_URL}/events/${ev.id}/publish`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ is_published: !ev.is_published })
      })
      if (res.ok) {
        setEvents(prev => prev.map(e => e.id === ev.id ? { ...e, is_published: !ev.is_published } : e))
      }
    } catch (err) { console.error('Toggle publish failed:', err) }
    setTogglingId(null)
  }

  async function deleteEvent(id) {
    setDeletingId(id)
    const token = localStorage.getItem('token')
    const res = await fetch(`${API_URL}/events/${id}`, {
      method: 'DELETE', headers: { Authorization: `Bearer ${token}` }
    })
    if (res.ok) setEvents(p => p.filter(e => e.id !== id))
    setDeletingId(null)
    setConfirmDelete(null)
  }

  const filteredEvents = events.filter(ev => {
    if (filter === 'all') return true
    if (filter === 'published') return ev.is_published === true
    if (filter === 'unpublished') return !ev.is_published
    if (filter === 'expired') return ev.expires_at && new Date(ev.expires_at) < new Date()
    if (filter === 'selling') return ev.photo_selling_enabled === true
    return true
  })

  const counts = {
    all: events.length,
    published: events.filter(e => e.is_published).length,
    unpublished: events.filter(e => !e.is_published).length,
    expired: events.filter(e => e.expires_at && new Date(e.expires_at) < new Date()).length,
    selling: events.filter(e => e.photo_selling_enabled).length,
  }

  const tabs = [
    ['all', 'All'],
    ['published', 'Published'],
    ['unpublished', 'Unpublished'],
    ['expired', 'Expired'],
    ['selling', 'Photo Selling'],
  ]

  return (
    <div className="events-root">
      <style>{styles}</style>

      <div style={{ padding: '40px 44px 64px', maxWidth: 1280, margin: '0 auto' }}>

        {/* ── Page header ── */}
        <div style={{ display: 'flex', alignItems: 'flex-end', justifyContent: 'space-between', marginBottom: 32, flexWrap: 'wrap', gap: 16 }}>
          <div>
            <div style={{
              fontSize: 11, color: 'var(--ink-mute)', textTransform: 'uppercase',
              letterSpacing: '0.12em', fontWeight: 500, marginBottom: 10,
              fontFamily: 'var(--mono)'
            }}>
              Studio · Events
            </div>
            <h1 style={{
              fontFamily: 'var(--serif)', fontSize: 48, fontWeight: 400,
              letterSpacing: '-0.02em', margin: 0, lineHeight: 1.05,
            }}>
              My <em style={{ fontStyle: 'italic' }}>events</em>
            </h1>
            <p style={{ fontSize: 14, color: 'var(--ink-mute)', marginTop: 10, maxWidth: 420, lineHeight: 1.5 }}>
              {events.length} event{events.length !== 1 ? 's' : ''} in your studio
              {counts.published > 0 ? ` · ${counts.published} published` : ''}
            </p>
          </div>

          <button
            className="btn btn-primary"
            onClick={() => router.push('/dashboard/create-event')}
            style={{ fontSize: 13.5, padding: '10px 20px' }}
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M6.5 1v11M1 6.5h11" stroke="currentColor" strokeWidth="2" strokeLinecap="round" />
            </svg>
            New event
          </button>
        </div>

        {/* ── Divider ── */}
        <div style={{ borderTop: '1px solid var(--line)', marginBottom: 28 }} />

        {/* ── Filter tabs ── */}
        <div style={{ marginBottom: 28, overflowX: 'auto' }}>
          <div className="filter-tabs" style={{ width: 'fit-content' }}>
            {tabs.map(([k, l]) => (
              <button
                key={k}
                className={`filter-tab${filter === k ? ' active' : ''}`}
                onClick={() => setFilter(k)}
              >
                {l}
                <span className="badge">{counts[k]}</span>
              </button>
            ))}
          </div>
        </div>

        {/* ── Content ── */}
        {loading ? (
          <div style={{ padding: '80px 0', textAlign: 'center', color: 'var(--ink-mute)', fontFamily: 'var(--mono)', fontSize: 12, letterSpacing: '0.08em' }}>
            Loading events…
          </div>
        ) : filteredEvents.length === 0 ? (
          <div className="empty-state">
            <div style={{ fontSize: 36, marginBottom: 14 }}>📷</div>
            <div style={{ fontFamily: 'var(--serif)', fontSize: 26, fontWeight: 400, marginBottom: 8 }}>
              {filter === 'all' ? 'No events yet' : `No ${filter} events`}
            </div>
            <p style={{ color: 'var(--ink-mute)', fontSize: 14, maxWidth: 320, margin: '0 auto 20px', lineHeight: 1.6 }}>
              {filter === 'all'
                ? 'Create your first event and start sharing beautiful galleries with your guests.'
                : `You don't have any ${filter} events right now.`}
            </p>
            {filter === 'all' && (
              <button
                className="btn btn-primary"
                onClick={() => router.push('/dashboard/create-event')}
              >
                Create your first event
              </button>
            )}
          </div>
        ) : (
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))', gap: 18 }}>
            {filteredEvents.map((ev, i) => {
              const isPublished = ev.is_published === true
              const isExpired = ev.expires_at && new Date(ev.expires_at) < new Date()
              const isToggling = togglingId === ev.id
              const hasCover = !!ev.cover_url

              return (
                <div key={ev.id} style={{ position: 'relative' }}>
                  <Link href={`/dashboard/events/${ev.id}`} className="event-card">

                    {/* Cover */}
                    <div
                      className="event-cover"
                      style={{ background: hasCover ? '#1a1714' : eventColors[i % 6] }}
                    >
                      {hasCover && (
                        <img
                          src={ev.cover_url}
                          alt={ev.name}
                          onError={e => { e.target.style.display = 'none' }}
                        />
                      )}

                      {/* Status badge */}
                      <div
                        className="event-status-badge"
                        style={
                          isExpired
                            ? { background: 'rgba(220,38,38,0.82)', color: '#fff' }
                            : isPublished
                            ? { background: 'rgba(22,163,74,0.85)', color: '#fff' }
                            : { background: 'rgba(26,23,20,0.55)', color: 'rgba(250,249,247,0.9)' }
                        }
                      >
                        {isExpired ? 'Expired' : isPublished ? '● Live' : '○ Draft'}
                      </div>

                      {hasCover && (
                        <div className="cover-badge">📸 Cover set</div>
                      )}

                      {isExpired && (
                        <div className="expired-bar">Event expired</div>
                      )}
                    </div>

                    {/* Body */}
                    <div className="event-body">
                      <h3 className="event-name">{ev.name}</h3>
                      <div className="event-slug">/{ev.slug}</div>

                      {/* Feature badges */}
                      {(ev.guest_upload_enabled || ev.public_gallery) && (
                        <div className="feature-badges">
                          {ev.guest_upload_enabled && (
                            <span
                              className="feature-badge"
                              style={{ background: 'var(--success-bg)', color: 'var(--success)', border: '1px solid rgba(22,163,74,0.2)' }}
                            >
                              Guest Upload
                            </span>
                          )}
                          {ev.public_gallery && (
                            <span
                              className="feature-badge"
                              style={{ background: 'var(--accent-bg)', color: 'var(--accent)', border: '1px solid rgba(37,99,235,0.2)' }}
                            >
                              Public Gallery
                            </span>
                          )}
                        </div>
                      )}

                      {/* Divider */}
                      <div style={{ borderTop: '1px solid var(--line-soft)', marginBottom: 12 }} />

                      {/* Publish toggle */}
                      <button
                        className="publish-toggle"
                        onClick={(e) => togglePublish(ev, e)}
                        disabled={isToggling}
                        style={
                          isPublished
                            ? {
                                border: '1px solid rgba(22,163,74,0.25)',
                                background: 'var(--success-bg)',
                                color: 'var(--success)',
                                opacity: isToggling ? 0.6 : 1,
                                cursor: isToggling ? 'wait' : 'pointer',
                              }
                            : {
                                border: '1px solid var(--line)',
                                background: 'var(--bg-soft)',
                                color: 'var(--ink-mute)',
                                opacity: isToggling ? 0.6 : 1,
                                cursor: isToggling ? 'wait' : 'pointer',
                              }
                        }
                      >
                        {isToggling
                          ? 'Updating…'
                          : isPublished
                          ? '● Published · click to unpublish'
                          : '○ Draft · click to publish'}
                      </button>
                    </div>
                  </Link>

                  {/* Delete button — outside Link to avoid nested <a> */}
                  <button
                    className="delete-btn"
                    onClick={e => { e.preventDefault(); setConfirmDelete(ev.id) }}
                    title="Delete event"
                  >
                    ✕
                  </button>
                </div>
              )
            })}
          </div>
        )}
      </div>

      {/* ── Delete modal ── */}
      {confirmDelete && (
        <div className="modal-overlay" onClick={() => setConfirmDelete(null)}>
          <div className="modal" onClick={e => e.stopPropagation()}>
            <div style={{ fontFamily: 'var(--serif)', fontSize: 28, fontWeight: 400, marginBottom: 6 }}>
              Delete event?
            </div>
            <p style={{ fontSize: 13.5, color: 'var(--ink-mute)', margin: '0 0 24px', lineHeight: 1.65 }}>
              All photos and face embeddings will be permanently removed from storage. This action cannot be undone.
            </p>
            <div style={{ display: 'flex', gap: 10 }}>
              <button
                className="btn btn-outline"
                style={{ flex: 1, justifyContent: 'center' }}
                onClick={() => setConfirmDelete(null)}
              >
                Cancel
              </button>
              <button
                className="btn"
                style={{
                  flex: 1, justifyContent: 'center',
                  background: 'var(--danger)', color: '#fff',
                  opacity: deletingId === confirmDelete ? 0.6 : 1,
                  cursor: deletingId === confirmDelete ? 'wait' : 'pointer',
                }}
                onClick={() => deleteEvent(confirmDelete)}
                disabled={deletingId === confirmDelete}
              >
                {deletingId === confirmDelete ? 'Deleting…' : 'Delete event'}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
