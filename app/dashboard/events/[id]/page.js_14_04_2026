// ─── PhotoViewer (Lightbox) ───────────────────────────────────────────────────
// Opens on card click. Shows full photo.url, download button, prev/next nav.
// Keyboard: ArrowLeft / ArrowRight / Escape
function PhotoViewer({ photos, currentIndex, onClose, onDownload }) {
  const [idx, setIdx] = useState(currentIndex)

  useEffect(() => {
    function onKey(e) {
      if (e.key === 'ArrowRight') setIdx(i => Math.min(i + 1, photos.length - 1))
      if (e.key === 'ArrowLeft')  setIdx(i => Math.max(i - 1, 0))
      if (e.key === 'Escape')     onClose()
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [photos.length, onClose])

  const photo    = photos[idx]
  const filename = photo.storage_key?.split('/').pop()?.split('_').slice(1).join('_')
                || photo.storage_key?.split('/').pop() || 'photo.jpg'

  return (
    <div
      onClick={onClose}
      style={{
        position: 'fixed', inset: 0, zIndex: 2000,
        background: 'rgba(10,5,30,0.92)', backdropFilter: 'blur(10px)',
        display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
      }}
    >
      {/* Top bar */}
      <div
        onClick={e => e.stopPropagation()}
        style={{
          position: 'absolute', top: 0, left: 0, right: 0,
          height: 56, display: 'flex', alignItems: 'center', justifyContent: 'space-between',
          padding: '0 20px',
          background: 'linear-gradient(to bottom, rgba(10,5,30,0.8), transparent)',
        }}
      >
        <div style={{ fontSize: 13, fontWeight: 600, color: 'rgba(255,255,255,0.8)' }}>
          {idx + 1} / {photos.length} — {filename}
        </div>
        <div style={{ display: 'flex', gap: 8 }}>
          <button
            onClick={() => onDownload(photo)}
            style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '7px 16px', borderRadius: 10, border: '1px solid rgba(255,255,255,0.2)', background: 'rgba(255,255,255,0.1)', color: '#fff', fontSize: 12, fontWeight: 600, cursor: 'pointer' }}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
          </button>
          <button
            onClick={onClose}
            style={{ width: 34, height: 34, borderRadius: 10, border: '1px solid rgba(255,255,255,0.2)', background: 'rgba(255,255,255,0.1)', color: '#fff', fontSize: 18, cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center' }}
          >✕</button>
        </div>
      </div>

      {/* Prev button */}
      {idx > 0 && (
        <button
          onClick={e => { e.stopPropagation(); setIdx(i => i - 1) }}
          style={{ position: 'absolute', left: 16, top: '50%', transform: 'translateY(-50%)', width: 44, height: 44, borderRadius: 12, border: '1px solid rgba(255,255,255,0.15)', background: 'rgba(255,255,255,0.1)', color: '#fff', fontSize: 20, cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', backdropFilter: 'blur(6px)' }}
        >‹</button>
      )}

      {/* Image */}
      <img
        src={photo.url || photo.thumb_url}
        alt={filename}
        onClick={e => e.stopPropagation()}
        style={{ maxWidth: 'calc(100vw - 120px)', maxHeight: 'calc(100vh - 100px)', borderRadius: 12, objectFit: 'contain', boxShadow: '0 24px 80px rgba(0,0,0,0.6)' }}
      />

      {/* Next button */}
      {idx < photos.length - 1 && (
        <button
          onClick={e => { e.stopPropagation(); setIdx(i => i + 1) }}
          style={{ position: 'absolute', right: 16, top: '50%', transform: 'translateY(-50%)', width: 44, height: 44, borderRadius: 12, border: '1px solid rgba(255,255,255,0.15)', background: 'rgba(255,255,255,0.1)', color: '#fff', fontSize: 20, cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', backdropFilter: 'blur(6px)' }}
        >›</button>
      )}

      {/* Bottom filmstrip counter dots */}
      <div style={{ position: 'absolute', bottom: 16, display: 'flex', gap: 5, alignItems: 'center' }}>
        {photos.length <= 20 && photos.map((_, i) => (
          <div
            key={i}
            onClick={e => { e.stopPropagation(); setIdx(i) }}
            style={{ width: i === idx ? 18 : 6, height: 6, borderRadius: 3, background: i === idx ? '#9b7fe8' : 'rgba(255,255,255,0.3)', transition: 'all .2s', cursor: 'pointer' }}
          />
        ))}
      </div>
    </div>
  )
}

// ─── UploadProgressBar ────────────────────────────────────────────────────────
// UNTOUCHED — architecture is working perfectly.
// Reads progressRef on a throttled interval; never causes parent re-renders.
function UploadProgressBar({ progressRef, uploading, onClear }) {
  const [snap, setSnap] = useState({ done: 0, total: 0, avgSaving: 0, errors: 0, dupes: 0 })

  useEffect(() => {
    const id = setInterval(() => setSnap({ ...progressRef.current }), UI_THROTTLE_MS)
    return () => clearInterval(id)
  }, [])

  const pct = snap.total > 0 ? Math.round((snap.done / snap.total) * 100) : 0

  return (
    <div style={{
      background: 'rgba(255,255,255,0.28)', backdropFilter: 'blur(20px)',
      WebkitBackdropFilter: 'blur(20px)', border: '1px solid rgba(255,255,255,0.55)',
      borderRadius: 20, padding: '18px 22px',
      boxShadow: '0 4px 24px rgba(100,80,180,0.08), inset 0 1px 0 rgba(255,255,255,0.5)',
    }}>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 14 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
          <div style={{
            width: 10, height: 10, borderRadius: '50%', flexShrink: 0,
            background: uploading ? '#9b7fe8' : '#22c55e',
            ...(uploading ? { animation: 'pulse 1s ease-in-out infinite' } : {})
          }} />
          <span style={{ fontSize: 14, fontWeight: 700, color: '#2d1b69' }}>
            {uploading ? 'Uploading photos…' : 'Upload complete — loading gallery…'}
          </span>
        </div>
        {!uploading && (
          <button onClick={onClear} style={{ fontSize: 11, color: '#9b89c4', background: 'transparent', border: 'none', cursor: 'pointer', padding: '2px 6px' }}>
            Clear
          </button>
        )}
      </div>

      <div style={{ height: 8, background: 'rgba(155,127,232,0.15)', borderRadius: 8, overflow: 'hidden', marginBottom: 10 }}>
        <div style={{
          height: 8, width: `${pct}%`, borderRadius: 8,
          background: uploading ? 'linear-gradient(90deg,#9b7fe8,#c084fc)' : 'linear-gradient(90deg,#22c55e,#4ade80)',
          transition: `width ${UI_THROTTLE_MS}ms ease-out`,
        }} />
      </div>

      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <span style={{ fontSize: 13, color: '#7c6aaa', fontWeight: 600 }}>
          {snap.done} / {snap.total} photos
          {snap.dupes  > 0 && <span style={{ color: '#d97706' }}> · {snap.dupes} skipped</span>}
          {snap.errors > 0 && <span style={{ color: '#ef4444' }}> · {snap.errors} failed</span>}
        </span>
        <span style={{ fontSize: 14, fontWeight: 800, color: uploading ? '#7c3aed' : '#15803d' }}>{pct}%</span>
      </div>

      {snap.avgSaving > 0 && (
        <div style={{ marginTop: 8, fontSize: 11, color: '#15803d', fontWeight: 600 }}>
          ↓ {snap.avgSaving}% avg file size saved by compression
        </div>
      )}
    </div>
  )
}

// ─── CompressionModal ─────────────────────────────────────────────────────────
// Shown after file selection, before upload begins.
// Free plan: compress is forced (checkbox locked).
// Paid plan: can toggle compression off, and choose quality preset.
function CompressionModal({ files, userPlan, onConfirm, onCancel }) {
  const isPaid        = userPlan === 'paid'
  // Free users must compress. Paid users default to compress but can disable.
  const [compress,    setCompress]    = useState(true)
  const [qualityIdx,  setQualityIdx]  = useState(1)   // default: Medium (index 1)

  const totalSize     = files.reduce((s, f) => s + f.size, 0)
  const selectedQuality = QUALITY_PRESETS[qualityIdx]

  // Rough estimated output size based on typical compression ratios
  const estimatedRatio = compress
    ? (qualityIdx === 0 ? 0.35 : qualityIdx === 1 ? 0.20 : 0.12)
    : 1
  const estimatedSize = totalSize * estimatedRatio

  return (
    // Backdrop
    <div style={{
      position: 'fixed', inset: 0, zIndex: 1000,
      background: 'rgba(20,10,50,0.55)', backdropFilter: 'blur(6px)',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      padding: 20,
    }}>
      {/* Modal box */}
      <div style={{
        width: '100%', maxWidth: 480,
        background: 'rgba(255,255,255,0.97)',
        borderRadius: 24, overflow: 'hidden',
        boxShadow: '0 32px 80px rgba(45,27,105,0.22)',
        border: '1px solid rgba(155,127,232,0.2)',
      }}>

        {/* Header */}
        <div style={{ background: 'linear-gradient(135deg,#2d1b69,#4b0082)', padding: '20px 24px' }}>
          <div style={{ fontSize: 16, fontWeight: 800, color: '#fff', marginBottom: 4 }}>
            Ready to upload {files.length} photo{files.length > 1 ? 's' : ''}
          </div>
          <div style={{ fontSize: 12, color: 'rgba(255,255,255,0.65)' }}>
            Total size: {formatSize(totalSize)}
          </div>
        </div>

        <div style={{ padding: '20px 24px 24px' }}>

          {/* Compress toggle row */}
          <div style={{
            display: 'flex', alignItems: 'center', justifyContent: 'space-between',
            padding: '14px 16px', borderRadius: 14,
            background: compress ? 'rgba(155,127,232,0.07)' : 'rgba(0,0,0,0.03)',
            border: `1.5px solid ${compress ? 'rgba(155,127,232,0.3)' : 'rgba(0,0,0,0.08)'}`,
            marginBottom: 16, transition: 'all .2s',
          }}>
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 14, fontWeight: 700, color: '#2d1b69', marginBottom: 2 }}>
                Compress images
              </div>
              <div style={{ fontSize: 11, color: '#9b89c4' }}>
                {isPaid
                  ? 'Paid plan — you can upload originals'
                  : 'Free plan — compression is required'}
              </div>
            </div>

            {/* Toggle switch */}
            <div
              onClick={() => isPaid && setCompress(v => !v)}
              style={{
                width: 44, height: 24, borderRadius: 12, flexShrink: 0,
                background: compress ? '#7c3aed' : '#d1d5db',
                position: 'relative', transition: 'background .2s',
                cursor: isPaid ? 'pointer' : 'not-allowed',
                opacity: isPaid ? 1 : 0.6,
              }}
            >
              <div style={{
                position: 'absolute', top: 3,
                left: compress ? 23 : 3,
                width: 18, height: 18, borderRadius: '50%',
                background: '#fff',
                transition: 'left .2s',
                boxShadow: '0 1px 4px rgba(0,0,0,0.2)',
              }} />
            </div>
          </div>

          {/* Quality picker — only shown when compression is on */}
          {compress && (
            <div style={{ marginBottom: 20 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: '#5b4a8a', marginBottom: 10, letterSpacing: '.04em', textTransform: 'uppercase' }}>
                Compression Quality
              </div>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 8 }}>
                {QUALITY_PRESETS.map((p, i) => (
                  <button
                    key={p.label}
                    onClick={() => setQualityIdx(i)}
                    style={{
                      padding: '10px 8px', borderRadius: 12, border: 'none', cursor: 'pointer',
                      background: qualityIdx === i ? 'linear-gradient(135deg,#9b7fe8,#c084fc)' : 'rgba(155,127,232,0.06)',
                      outline: qualityIdx === i ? '2px solid #9b7fe8' : '2px solid transparent',
                      outlineOffset: 2, transition: 'all .15s',
                    }}
                  >
                    <div style={{ fontSize: 13, fontWeight: 700, color: qualityIdx === i ? '#fff' : '#2d1b69', marginBottom: 3 }}>
                      {p.label}
                    </div>
                    <div style={{ fontSize: 10, color: qualityIdx === i ? 'rgba(255,255,255,0.8)' : '#9b89c4', lineHeight: 1.4 }}>
                      {p.desc}
                    </div>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Size estimate row */}
          <div style={{
            display: 'flex', alignItems: 'center', justifyContent: 'space-between',
            padding: '10px 14px', borderRadius: 10,
            background: 'rgba(34,197,94,0.06)', border: '1px solid rgba(34,197,94,0.15)',
            marginBottom: 20,
          }}>
            <span style={{ fontSize: 12, color: '#5b4a8a', fontWeight: 500 }}>Estimated upload size</span>
            <span style={{ fontSize: 13, fontWeight: 800, color: '#15803d' }}>
              {compress
                ? `~${formatSize(estimatedSize)} (↓ ~${Math.round((1 - estimatedRatio) * 100)}%)`
                : formatSize(totalSize)
              }
            </span>
          </div>

          {/* Action buttons */}
          <div style={{ display: 'flex', gap: 10 }}>
            <button
              onClick={onCancel}
              style={{ flex: 1, padding: '12px', borderRadius: 12, border: '1.5px solid rgba(155,127,232,0.2)', background: 'transparent', fontSize: 13, fontWeight: 600, color: '#7c6aaa', cursor: 'pointer' }}
            >
              Cancel
            </button>
            <button
              onClick={() => onConfirm({ compress, quality: compress ? selectedQuality.value : null })}
              style={{ flex: 2, padding: '12px', borderRadius: 12, border: 'none', background: 'linear-gradient(135deg,#2d1b69,#4b0082)', fontSize: 13, fontWeight: 700, color: '#fff', cursor: 'pointer', boxShadow: '0 4px 14px rgba(75,0,130,0.35)' }}
            >
              Start Upload →
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}

