  const [uploading,     setUploading]     = useState(false)
  const [showProgress,  setShowProgress]  = useState(false)
  const [activeSection, setActiveSection] = useState('all')
  const [searchQuery,   setSearchQuery]   = useState('')
  const [viewMode,      setViewMode]      = useState('grid')
  const [copied,        setCopied]        = useState(false)
  const [visibleCount,  setVisibleCount]  = useState(30)

  // Compression modal state
  const [pendingFiles,  setPendingFiles]  = useState(null)   // files waiting for modal confirm
  const [showModal,     setShowModal]     = useState(false)

  // Selection + viewer state
  const [selectedIds,   setSelectedIds]   = useState(new Set())
  const [viewerIndex,   setViewerIndex]   = useState(null)   // null = closed

  // Upload counters live in a ref — never trigger parent re-renders
  const progressRef = useRef({ done: 0, total: 0, errors: 0, dupes: 0, savingSum: 0, savingCount: 0, avgSaving: 0 })

  useEffect(() => { loadEvent(); loadPhotos() }, [id])
  useEffect(() => { setVisibleCount(30) }, [activeSection, searchQuery])

  async function loadEvent() {
    const token = localStorage.getItem('token')
    const res   = await fetch(`${API_URL}/events/`, { headers: { Authorization: `Bearer ${token}` } })
    const evs   = await res.json()
    if (Array.isArray(evs)) { const ev = evs.find(e => e.id === id); if (ev) setEvent(ev) }
  }

  // loadPhotos: no optimistic preview logic — only real server records
  async function loadPhotos() {
    const token = localStorage.getItem('token')
    try {
      const res  = await fetch(`${API_URL}/photos/${id}`, { headers: { Authorization: `Bearer ${token}` } })
      const data = await res.json()
      if (Array.isArray(data)) setPhotos(data)
    } catch (e) { console.error(e) }
    setLoading(false)
  }

  // ── Compression ───────────────────────────────────────────────────────────
  // Returns a Blob — always a re-encoded JPEG. Never returns the original File
  // to prevent full-resolution images leaking into the UI via blob URLs.
  async function compressImage(file, quality) {
    return new Promise(resolve => {
      const isHEIC = /\.(heic|heif)$/i.test(file.name) || /heic|heif/.test(file.type)
      if (isHEIC) { resolve(new Blob([file], { type: file.type })); return }

      const img = new Image()
      const url = URL.createObjectURL(file)
      const fallback = () => resolve(new Blob([file], { type: 'image/jpeg' }))

      img.onload = () => {
        URL.revokeObjectURL(url)
        let w = img.naturalWidth, h = img.naturalHeight
        const m = Math.max(w, h)
        if (m > COMPRESS_MAX_PX) { const s = COMPRESS_MAX_PX / m; w = Math.round(w * s); h = Math.round(h * s) }
        const canvas = document.createElement('canvas')
        canvas.width = w; canvas.height = h
        const ctx = canvas.getContext('2d')
        if (!ctx) { fallback(); return }
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h)
        ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high'
        ctx.drawImage(img, 0, 0, w, h)
        // Always output the re-encoded JPEG — never the original File object
        canvas.toBlob(blob => resolve(blob || new Blob([file], { type: 'image/jpeg' })), 'image/jpeg', quality)
      }
      img.onerror = () => { URL.revokeObjectURL(url); fallback() }
      img.src = url
    })
  }

  async function computeHash(blob) {
    try {
      const buf = await blob.arrayBuffer()
      const h   = await crypto.subtle.digest('SHA-256', buf)
      return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2, '0')).join('')
    } catch { return `${blob.size}_${Date.now()}_${Math.random().toString(36).slice(2)}` }
  }

  // ── uploadSingleFile ──────────────────────────────────────────────────────
  // compressOpts: { compress: bool, quality: number|null }
  // If compress=false (paid users only): uploads the raw file bytes directly.
  // All XHR progress → ref mutation only. No setState in the hot path.
  async function uploadSingleFile(file, compressOpts) {
    const token = localStorage.getItem('token')

    // Decide what bytes to send to R2
    let payload, savingPct
    if (compressOpts.compress) {
      const blob = await compressImage(file, compressOpts.quality)
      savingPct  = Math.max(0, Math.round((1 - blob.size / file.size) * 100))
      payload    = blob
    } else {
      // Paid user chose to skip compression — upload original bytes
      payload   = new Blob([file], { type: file.type })
      savingPct = 0
    }

    const fileHash = await computeHash(payload)

    const presignRes = await fetch(`${API_URL}/photos/${id}/presign`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({
        filename:     file.name.replace(/[^a-zA-Z0-9._-]/g, '_'),
        file_hash:    fileHash,
        file_size:    payload.size,
        content_type: compressOpts.compress ? 'image/jpeg' : (file.type || 'image/jpeg'),
      }),
    })
    if (presignRes.status === 402) {
      const err = await presignRes.json().catch(() => ({}))
      throw new Error(err.detail?.code || 'quota_exceeded')
    }
    if (!presignRes.ok) throw new Error(`presign_${presignRes.status}`)

    const presignData = await presignRes.json()
    if (presignData.status === 'duplicate') return { status: 'duplicate' }

    const { photo_id, upload_url, storage_key } = presignData

    // XHR PUT — progress writes to ref only, never setState
    await new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest()
      xhr.open('PUT', upload_url, true)
      xhr.setRequestHeader('Content-Type', compressOpts.compress ? 'image/jpeg' : (file.type || 'image/jpeg'))
      xhr.onload    = () => xhr.status >= 200 && xhr.status < 300 ? resolve() : reject(new Error(`r2_${xhr.status}`))
      xhr.onerror   = () => reject(new Error('network_error'))
      xhr.timeout   = 300000
      xhr.ontimeout = () => reject(new Error('upload_timeout'))
      xhr.send(payload)
    })

    const confirmRes = await fetch(`${API_URL}/photos/${id}/confirm/${photo_id}`, {
      method: 'POST', headers: { Authorization: `Bearer ${token}` },
    })
    if (!confirmRes.ok) throw new Error(`confirm_${confirmRes.status}`)

    // payload blob goes out of scope here — GC-eligible after return
    return { status: 'done', photo_id, storage_key, saving: savingPct }
  }

  // ── File selection: show modal first, don't start upload yet ─────────────
  function handleFileSelect(e) {
    const raw = Array.from(e.target.files || [])
    if (fileRef.current) fileRef.current.value = ''
    if (!raw.length) return

    // Deduplicate
    const seen = new Set()
    const files = raw.filter(f => {
      const k = `${f.name}_${f.size}`; if (seen.has(k)) return false; seen.add(k); return true
    })

    setPendingFiles(files)
    setShowModal(true)
  }

  // ── Modal confirmed: start upload with chosen options ────────────────────
  function handleModalConfirm(compressOpts) {
    setShowModal(false)
    const files = pendingFiles
    setPendingFiles(null)
    startUpload(files, compressOpts)
  }

  function handleModalCancel() {
    setShowModal(false)
    setPendingFiles(null)
  }

  // ── Core upload loop ──────────────────────────────────────────────────────
  // A setInterval polls loadPhotos() every 4s throughout the upload.
  // Celery typically finishes a thumbnail in 2-4s after confirm, so by the
  // time the next poll fires the thumb_url is ready and appears in the grid.
  // This means photo 1 shows up while photos 2-20 are still uploading.
  // The final explicit loadPhotos() after the loop catches anything missed.
  // setUploading(false) only fires after that final call resolves.
  async function startUpload(files, compressOpts) {
    progressRef.current = { done: 0, total: files.length, errors: 0, dupes: 0, savingSum: 0, savingCount: 0, avgSaving: 0 }
    setShowProgress(true)
    setUploading(true)

    // Guard against overlapping poll calls if loadPhotos() takes > 4s
    let pollBusy = false
    const pollInterval = setInterval(async () => {
      if (pollBusy) return
      pollBusy = true
      await loadPhotos()
      pollBusy = false
    }, 4000)

    try {
      for (let i = 0; i < files.length; i += CONCURRENT_UPLOADS) {
        const batch = files.slice(i, i + CONCURRENT_UPLOADS)
        await Promise.allSettled(batch.map(async file => {
          let lastErr
          for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
            try {
              const result = await uploadSingleFile(file, compressOpts)
              if (result.status === 'duplicate') {
                progressRef.current.dupes++
                progressRef.current.done++
              } else if (result.status === 'done') {
                progressRef.current.done++
                if (result.saving > 0) {
                  progressRef.current.savingSum   += result.saving
                  progressRef.current.savingCount += 1
                  progressRef.current.avgSaving    = Math.round(progressRef.current.savingSum / progressRef.current.savingCount)
                }
              }
              return
            } catch (err) {
              lastErr = err
              if (err.message?.includes('quota')) {
                progressRef.current.errors++
                progressRef.current.done++
                return
              }
              if (attempt < MAX_RETRIES) await new Promise(r => setTimeout(r, 1500 * attempt))
            }
          }
          progressRef.current.errors++
          progressRef.current.done++
          console.error(`Upload failed: ${file.name}`, lastErr?.message)
        }))
      }
    } finally {
      clearInterval(pollInterval)   // always stop polling — even if something throws
    }

    // Final fetch — catches anything Celery finished between the last poll and now
    await loadPhotos()

    // Bar flips to "Upload complete" only after this final loadPhotos() resolves
    setUploading(false)
  }

