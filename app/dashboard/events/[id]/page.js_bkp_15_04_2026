// ═══════════════════════════════════════════════════════════════════════════════
// QRCode
// ═══════════════════════════════════════════════════════════════════════════════
function QRCode({ url, size = 160 }) {
  const ref = useRef(null)
  useEffect(() => {
    if (!url || !ref.current) return
    import('qrcode').then(lib =>
      lib.default.toCanvas(ref.current, url, {
        width: size, margin: 2,
        color: { dark: '#2d1b69', light: '#ffffff' },
        errorCorrectionLevel: 'M',
      })
    )
  }, [url, size])
  return <canvas ref={ref} style={{ borderRadius: 12, display: 'block' }} width={size} height={size} />
}

// ═══════════════════════════════════════════════════════════════════════════════
// PhotoMenu  — the ⋮ dropdown on each card
// ═══════════════════════════════════════════════════════════════════════════════
function PhotoMenu({ photo, collections, colPhotoIds, onMakeCover, onDelete, onAddToCol, onRemoveFromCol }) {
  const [open,    setOpen]    = useState(false)
  const [colOpen, setColOpen] = useState(false)
  const ref                   = useRef(null)

  // close on outside click
  useEffect(() => {
    if (!open) { setColOpen(false); return }
    const handler = e => { if (ref.current && !ref.current.contains(e.target)) setOpen(false) }
    document.addEventListener('mousedown', handler)
    return () => document.removeEventListener('mousedown', handler)
  }, [open])

  const btnBase = {
    width: '100%', display: 'flex', alignItems: 'center', gap: 9,
    padding: '9px 14px', border: 'none', background: 'transparent',
    cursor: 'pointer', textAlign: 'left',
    borderBottom: '1px solid rgba(155,127,232,0.07)',
    transition: 'background .12s',
  }

  return (
    <div ref={ref} style={{ position: 'relative' }}>
      {/* trigger */}
      <button
        onClick={e => { e.stopPropagation(); setOpen(v => !v) }}
        style={{
          width: 28, height: 28, borderRadius: 7, border: 'none',
          background: open ? 'rgba(255,255,255,0.35)' : 'rgba(255,255,255,0.18)',
          backdropFilter: 'blur(6px)', cursor: 'pointer',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          color: '#fff', fontSize: 16, lineHeight: 1,
        }}
        onMouseEnter={e => e.currentTarget.style.background = 'rgba(255,255,255,0.35)'}
        onMouseLeave={e => e.currentTarget.style.background = open ? 'rgba(255,255,255,0.35)' : 'rgba(255,255,255,0.18)'}
      >⋮</button>

      {open && (
        <div style={{
          position: 'absolute', top: 34, right: 0, zIndex: 9999,
          background: 'rgba(255,255,255,0.98)', backdropFilter: 'blur(20px)',
          borderRadius: 14, border: '1px solid rgba(155,127,232,0.18)',
          boxShadow: '0 12px 40px rgba(45,27,105,0.2)', minWidth: 200, overflow: 'visible',
        }}>

          {/* Make Cover */}
          <button style={btnBase}
            onClick={() => { onMakeCover(photo); setOpen(false) }}
            onMouseEnter={e => e.currentTarget.style.background = 'rgba(155,127,232,0.07)'}
            onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
          >
            <span style={{ fontSize: 15 }}>🖼</span>
            <span style={{ fontSize: 13, fontWeight: 500, color: '#2d1b69', flex: 1 }}>Make Cover</span>
          </button>

          {/* Add to Collection → submenu */}
          <div
            style={{ position: 'relative' }}
            onMouseEnter={() => setColOpen(true)}
            onMouseLeave={() => setColOpen(false)}
          >
            <button style={btnBase}
              onMouseEnter={e => e.currentTarget.style.background = 'rgba(155,127,232,0.07)'}
              onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
            >
              <span style={{ fontSize: 15 }}>➕</span>
              <span style={{ fontSize: 13, fontWeight: 500, color: '#2d1b69', flex: 1 }}>Add to Collection</span>
              <span style={{ fontSize: 12, color: '#9b89c4' }}>›</span>
            </button>

            {colOpen && (
              <div style={{
                position: 'absolute', top: 0, right: '100%', marginRight: 4,
                background: 'rgba(255,255,255,0.98)', backdropFilter: 'blur(20px)',
                borderRadius: 12, border: '1px solid rgba(155,127,232,0.15)',
                boxShadow: '0 8px 30px rgba(45,27,105,0.15)',
                minWidth: 170, overflow: 'hidden',
              }}>
                {collections.length === 0
                  ? <div style={{ padding: '10px 14px', fontSize: 12, color: '#9b89c4', fontStyle: 'italic' }}>No collections yet</div>
                  : collections.map(col => {
                      const inCol = colPhotoIds[col.id]?.has(photo.id)
                      return (
                        <button key={col.id}
                          onClick={e => {
                            e.stopPropagation()
                            inCol ? onRemoveFromCol(photo, col) : onAddToCol(photo, col)
                            setOpen(false)
                          }}
                          style={{ ...btnBase, borderBottom: '1px solid rgba(155,127,232,0.07)' }}
                          onMouseEnter={e => e.currentTarget.style.background = 'rgba(155,127,232,0.07)'}
                          onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
                        >
                          <span style={{ fontSize: 12 }}>📁</span>
                          <span style={{ fontSize: 13, fontWeight: inCol ? 700 : 500, color: inCol ? '#7c3aed' : '#2d1b69', flex: 1 }}>
                            {col.name}
                          </span>
                          {inCol && <span style={{ fontSize: 11, color: '#7c3aed' }}>✓</span>}
                        </button>
                      )
                    })
                }
              </div>
            )}
          </div>

          {/* divider */}
          <div style={{ height: 1, background: 'rgba(155,127,232,0.12)', margin: '2px 0' }} />

          {/* Delete */}
          <button style={btnBase}
            onClick={() => { onDelete(photo); setOpen(false) }}
            onMouseEnter={e => e.currentTarget.style.background = 'rgba(239,68,68,0.06)'}
            onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
          >
            <span style={{ fontSize: 15 }}>🗑</span>
            <span style={{ fontSize: 13, fontWeight: 500, color: '#dc2626', flex: 1 }}>Delete</span>
          </button>
        </div>
      )}
    </div>
  )
}

