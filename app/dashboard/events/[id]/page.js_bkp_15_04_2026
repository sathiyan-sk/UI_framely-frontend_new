                  style={{ width: '100%', padding: '9px 12px', borderRadius: 10, border: '1.5px solid rgba(155,127,232,0.35)', fontSize: 13, color: '#2d1b69', outline: 'none', boxSizing: 'border-box', fontFamily: 'inherit' }}
                  onFocus={e => e.target.style.border = '1.5px solid #9b7fe8'}
