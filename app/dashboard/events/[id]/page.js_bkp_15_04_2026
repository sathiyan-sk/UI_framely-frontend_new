          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '14px 16px', borderRadius: 14, background: compress ? 'rgba(155,127,232,0.07)' : 'rgba(0,0,0,0.03)', border: `1.5px solid ${compress ? 'rgba(155,127,232,0.3)' : 'rgba(0,0,0,0.08)'}`, marginBottom: 16 }}>
            <div>
