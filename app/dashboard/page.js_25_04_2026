'use client'
import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import Link from 'next/link'

const API_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000'

// ── Design tokens — copied from target source ─────────────────────────────────
// var(--serif)      → Georgia, serif
// var(--mono)       → monospace
// var(--bg)         → #ffffff
// var(--bg-soft)    → #f5f5f5
// var(--bg-sunk)    → #ebebeb
// var(--line)       → #e5e5e5
// var(--line-soft)  → #f0f0f0
// var(--ink)        → #111111
// var(--ink-soft)   → #444444
// var(--ink-mute)   → #888888
// var(--accent)     → #2563eb   (blue, used for Live badge + progress bar)
// var(--accent-bg)  → #dbeafe

const T = {
  serif:     "Georgia, 'Times New Roman', serif",
  mono:      "'Courier New', Courier, monospace",
  bg:        '#ffffff',
  bgSoft:    '#f5f5f5',
  bgSunk:    '#ebebeb',
  line:      '#e5e5e5',
  lineSoft:  '#f0f0f0',
  ink:       '#111111',
  inkSoft:   '#444444',
  inkMute:   '#888888',
  accent:    '#2563eb',
  accentBg:  '#dbeafe',
}

// ── Placeholder (hatched, from source) ───────────────────────────────────────
function Placeholder({ aspect = '1 / 1', label, radius = 10 }) {
  return (
    <div style={{
      aspectRatio: aspect,
      width: '100%',
      borderRadius: radius,
      background: `repeating-linear-gradient(45deg, ${T.bgSunk} 0px, ${T.bgSunk} 10px, ${T.bgSoft} 10px, ${T.bgSoft} 20px)`,
      border: `1px solid ${T.line}`,
      display: 'grid',
      placeItems: 'center',
      position: 'relative',
      overflow: 'hidden',
    }}>
      {label && (
        <span style={{
          fontFamily: T.mono, fontSize: 10,
          color: T.inkMute, textTransform: 'uppercase', letterSpacing: '0.1em',
          background: T.bg, padding: '3px 7px', borderRadius: 3,
          border: `1px solid ${T.line}`,
        }}>
          {label}
        </span>
      )}
    </div>
  )
}

// ── Card (from source: border + borderRadius 14 + bg + padding 20) ───────────
function Card({ children, style, span, rowSpan }) {
  return (
    <div style={{
      border: `1px solid ${T.line}`,
      borderRadius: 14,
      background: T.bg,
      padding: 20,
      gridColumn: span ? `span ${span}` : undefined,
      gridRow: rowSpan ? `span ${rowSpan}` : undefined,
      minWidth: 0,
      ...style,
    }}>
      {children}
    </div>
  )
}

// ── Small icon SVGs matching source icon set ──────────────────────────────────
const IconCalendar = ({ size = 14 }) => (
  <svg width={size} height={size} fill="none" viewBox="0 0 16 16">
    <rect x="1" y="2.5" width="14" height="11" rx="2" stroke="currentColor" strokeWidth="1.3"/>
    <path d="M5 1v3M11 1v3" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round"/>
    <path d="M1 7h14" stroke="currentColor" strokeWidth="1.3"/>
  </svg>
)
const IconImage = ({ size = 14 }) => (
  <svg width={size} height={size} fill="none" viewBox="0 0 16 16">
    <rect x="1" y="2" width="14" height="11" rx="2" stroke="currentColor" strokeWidth="1.3"/>
    <circle cx="5.5" cy="7" r="1.8" stroke="currentColor" strokeWidth="1.1"/>
    <path d="M1 11l4-3.5 3 2.5 3-4 3.5 3" stroke="currentColor" strokeWidth="1.1" strokeLinecap="round" strokeLinejoin="round"/>
  </svg>
)
const IconEye = ({ size = 14 }) => (
  <svg width={size} height={size} fill="none" viewBox="0 0 16 16">
    <ellipse cx="8" cy="8" rx="7" ry="5" stroke="currentColor" strokeWidth="1.3"/>
    <circle cx="8" cy="8" r="2.2" stroke="currentColor" strokeWidth="1.3"/>
  </svg>
)
const IconChart = ({ size = 14 }) => (
  <svg width={size} height={size} fill="none" viewBox="0 0 16 16">
    <path d="M1 12l3.5-4 3 2.5 3.5-5.5 2.5 2" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" strokeLinejoin="round"/>
    <path d="M1 14h14" stroke="currentColor" strokeWidth="1.1" strokeLinecap="round"/>
  </svg>
)

// ── Status badge ──────────────────────────────────────────────────────────────
function StatusBadge({ status }) {
  const isLive = status === 'Live'
  return (
    <span style={{
      fontSize: 10, fontWeight: 600, letterSpacing: '0.08em', textTransform: 'uppercase',
      padding: '2px 6px', borderRadius: 3,
      background: isLive ? T.accentBg : T.bgSoft,
      color:      isLive ? T.accent   : T.inkMute,
    }}>
      {status}
    </span>
  )
}

// ── Main ──────────────────────────────────────────────────────────────────────
export default function DashboardHome() {
  const router = useRouter()

  const [events,           setEvents]          = useState([])
  const [totalPhotos,      setTotalPhotos]      = useState(0)
  const [recentPhotos,     setRecentPhotos]     = useState([])
  const [loading,          setLoading]          = useState(true)
  const [planData,         setPlanData]         = useState(null)
  const [eventPhotoCounts, setEventPhotoCounts] = useState({})

  useEffect(() => { loadData(); loadPlan() }, [])

  async function loadData() {
    const token = localStorage.getItem('token')
    try {
      const res = await fetch(`${API_URL}/events/`, { headers: { Authorization: `Bearer ${token}` } })
      const evs = await res.json()
      if (!Array.isArray(evs)) return
      setEvents(evs)
      let tp = 0, photos = [], counts = {}
      for (const ev of evs.slice(0, 5)) {
        const pr = await fetch(`${API_URL}/photos/${ev.id}`, { headers: { Authorization: `Bearer ${token}` } })
        const pd = await pr.json()
        if (Array.isArray(pd)) {
          counts[ev.id] = pd.length
          tp += pd.length
          photos.push(...pd.filter(p => p.url).slice(0, 6))
        }
      }
      setTotalPhotos(tp)
      setRecentPhotos(photos)
      setEventPhotoCounts(counts)
    } catch (e) { console.error(e) }
    setLoading(false)
  }

  async function loadPlan() {
    const token = localStorage.getItem('token')
    try {
      const res  = await fetch(`${API_URL}/payments/my-plan`, { headers: { Authorization: `Bearer ${token}` } })
      const data = await res.json()
      if (data.current_plan) setPlanData(data)
    } catch (e) { console.error(e) }
  }

  // Derived values
  const planName      = planData?.plan_name ?? 'Starter'
  const storageUsedGB = planData ? parseFloat((planData.storage_used_bytes / (1024 ** 3)).toFixed(1)) : 0
  const storageCapGB  = planData?.storage_limit_gb ?? 10
  const storagePct    = Math.min(Math.round((storageUsedGB / storageCapGB) * 100), 100)

  function eventStatus(ev, idx) {
    if (ev.is_published === false) return 'Scheduled'
    if (ev.end_date && new Date(ev.end_date) < new Date()) return 'Complete'
    if (ev.is_published) return 'Live'
    return ['Live', 'Scheduled', 'Complete'][idx % 3]
  }

  const renewsText = planData?.expires_at
    ? `Renews ${new Date(planData.expires_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}`
    : 'Renews May 1'

  const UPLOAD_LABELS = ['Forest', 'Portrait', 'Venue', 'Ceremony', 'Dinner', 'Reception']

  const activityItems = [
    { when: '2m ago',  text: 'Aanya R. downloaded 12 photos from Surya' },
    { when: '14m ago', text: 'New guest registered: Karthik M.' },
    { when: '1h ago',  text: 'Reel AI delivered 4 guest highlights' },
    { when: '3h ago',  text: `You uploaded ${totalPhotos > 0 ? totalPhotos : 48} photos to ${events[0]?.name || 'Surya'}` },
  ]

  // ── Stat cards config (matches source array exactly) ─────────────────────
  const statCards = [
    { label: 'Active events', val: events.length,                sub: `${events.filter(e => e.is_published).length} published`, Icon: IconCalendar },
    { label: 'Photos',        val: totalPhotos.toLocaleString(), sub: '+324 this week',                                          Icon: IconImage },
    { label: 'Gallery visits', val: 312,                         sub: '+48 today',                                               Icon: IconEye },
    { label: 'Downloads',     val: 127,                          sub: '+12 today',                                               Icon: IconChart },
  ]

  return (
    // Matches source: padding '32px 44px 60px', maxWidth 1400
    <div style={{
      fontFamily: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    }}>

      {/* ── Header — from HomeGrid source ── */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-end', marginBottom: 24 }}>
        <div>
          <div style={{
            fontSize: 11, color: T.inkMute, textTransform: 'uppercase',
            letterSpacing: '0.12em', fontWeight: 500, marginBottom: 6,
          }}>
            Dashboard
          </div>
          {/* Source: fontFamily serif, fontSize 36, fontWeight 400 */}
          <h1 style={{
            fontFamily: T.serif, fontSize: 36, margin: 0,
            letterSpacing: '-0.015em', fontWeight: 400, color: T.ink,
          }}>
            Hey <em style={{ fontStyle: 'italic' }}>Jaya</em>, here's today.
          </h1>
        </div>
        <div style={{ display: 'flex', gap: 10 }}>
          <button style={{
            padding: '8px 18px', border: `1px solid ${T.line}`, borderRadius: 8,
            background: T.bg, fontSize: 13, color: T.inkSoft, cursor: 'pointer', fontWeight: 500,
            fontFamily: 'inherit',
          }}>
            Upload
          </button>
          <button
            onClick={() => router.push('/dashboard/create-event')}
            style={{
              display: 'flex', alignItems: 'center', gap: 6,
              padding: '8px 18px', border: 'none', borderRadius: 8,
              background: T.ink, fontSize: 13, color: '#fff', cursor: 'pointer', fontWeight: 500,
              fontFamily: 'inherit',
            }}
          >
            + New event
          </button>
        </div>
      </div>

      {/* ── Grid — matches source: repeat(4, 1fr), gap 16 ── */}
      <div style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(4, 1fr)',
        gap: 16,
      }}>

        {/* ── 4 Stat cards — source: icon in 28×28 box, serif number at 36px ── */}
        {statCards.map((c, i) => (
          <Card key={i}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 20 }}>
              <div style={{
                fontSize: 11.5, color: T.inkMute,
                textTransform: 'uppercase', letterSpacing: '0.08em', fontWeight: 500,
              }}>
                {c.label}
              </div>
              {/* Source: 28×28 rounded box with icon */}
              <div style={{
                width: 28, height: 28, borderRadius: 7,
                background: T.bgSoft,
                display: 'grid', placeItems: 'center',
                color: T.inkMute,
              }}>
                <c.Icon size={14} />
              </div>
            </div>
            {/* Source: fontFamily serif, fontSize 36, letterSpacing -0.02em */}
            <div style={{
              fontFamily: T.serif, fontSize: 36, lineHeight: 1,
              letterSpacing: '-0.02em', color: T.ink,
            }}>
              {c.val}
            </div>
            <div style={{ fontSize: 11.5, color: T.inkMute, marginTop: 8 }}>{c.sub}</div>
          </Card>
        ))}

        {/* ── Active events — source: span 2, gridRow span 2 ── */}
        <Card span={2} rowSpan={2}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 14 }}>
            {/* Source: fontFamily serif, fontSize 20, fontWeight 400 */}
            <h3 style={{ fontFamily: T.serif, fontSize: 20, margin: 0, fontWeight: 400, color: T.ink }}>
              Active events
            </h3>
            <Link href="/dashboard/events" style={{ fontSize: 12, color: T.inkMute, textDecoration: 'none', fontFamily: T.mono }}>
              View all →
            </Link>
          </div>

          {loading ? (
            <div style={{ fontSize: 13, color: T.inkMute, padding: '12px 0' }}>Loading…</div>
          ) : events.length === 0 ? (
            <div style={{ fontSize: 13, color: T.inkMute, padding: '12px 0' }}>
              No events yet — <Link href="/dashboard/create-event" style={{ color: T.ink }}>create one</Link>
            </div>
          ) : (
            events.slice(0, 5).map((ev, i) => {
              const status   = eventStatus(ev, i)
              const picCount = eventPhotoCounts[ev.id] ?? 0
              const progress = status === 'Live' ? 62 : 0

              return (
                <Link key={ev.id} href={`/dashboard/events/${ev.id}`} style={{ textDecoration: 'none' }}>
                  {/* Source: flex gap 14, padding '14px 0', borderTop on non-first, alignItems center */}
                  <div
                    style={{
                      display: 'flex', gap: 14, padding: '14px 0',
                      borderTop: i === 0 ? 'none' : `1px solid ${T.lineSoft}`,
                      alignItems: 'center',
                      cursor: 'pointer',
                    }}
                    onMouseEnter={e => e.currentTarget.style.background = T.bgSoft}
                    onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
                  >
                    {/* Source: width 72 thumbnail */}
                    <div style={{ width: 72, flexShrink: 0 }}>
                      <Placeholder aspect="1 / 1" radius={8} />
                    </div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 2 }}>
                        <span style={{ fontSize: 14, fontWeight: 500, color: T.ink }}>{ev.name}</span>
                        <StatusBadge status={status} />
                      </div>
                      <div style={{ fontSize: 12, color: T.inkMute, marginTop: 2 }}>
                        {ev.event_type || 'Event'} · {ev.location || 'India'}
                      </div>
                      {/* Source: marginTop 10, height 3, bg bgSunk, borderRadius 99 */}
                      <div style={{ marginTop: 10, height: 3, background: T.bgSunk, borderRadius: 99, overflow: 'hidden' }}>
                        <div style={{ width: `${progress}%`, height: '100%', background: T.accent }} />
                      </div>
                    </div>
                    <span style={{ fontSize: 11, color: T.inkMute, fontFamily: T.mono, whiteSpace: 'nowrap', flexShrink: 0 }}>
                      {picCount} pics
                    </span>
                  </div>
                </Link>
              )
            })
          )}
        </Card>

        {/* ── Storage — source: single card, serif 30px number ── */}
        <Card>
          <div style={{
            fontSize: 11.5, color: T.inkMute, textTransform: 'uppercase',
            letterSpacing: '0.08em', fontWeight: 500, marginBottom: 16,
          }}>
            Storage
          </div>
          {/* Source: fontFamily serif, fontSize 30 */}
          <div style={{ fontFamily: T.serif, fontSize: 30, lineHeight: 1, letterSpacing: '-0.02em', color: T.ink }}>
            {storageUsedGB}
            <span style={{ color: T.inkMute, fontSize: 16, fontFamily: 'inherit' }}> / {storageCapGB} GB</span>
          </div>
          {/* Source: marginTop 14, height 6, borderRadius 99 */}
          <div style={{ marginTop: 14, height: 6, background: T.bgSunk, borderRadius: 99, overflow: 'hidden' }}>
            <div style={{ width: `${Math.max(storagePct, storagePct > 0 ? storagePct : 0.5)}%`, height: '100%', background: T.accent }} />
          </div>
          <div style={{ fontSize: 11.5, color: T.inkMute, marginTop: 8 }}>{storagePct.toFixed(1)}% used</div>
        </Card>

        {/* ── Your Plan — source: flex justify-between, serif 22 ── */}
        <Card>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
            <div>
              <div style={{
                fontSize: 11.5, color: T.inkMute, textTransform: 'uppercase',
                letterSpacing: '0.08em', fontWeight: 500, marginBottom: 8,
              }}>
                Your plan
              </div>
              {/* Source: fontFamily serif, fontSize 22, fontWeight 400 */}
              <div style={{ fontFamily: T.serif, fontSize: 22, fontWeight: 400, color: T.ink }}>
                {planName}
              </div>
              <div style={{ fontSize: 11.5, color: T.inkMute, marginTop: 4 }}>{renewsText}</div>
            </div>
            {/* Source: accentBg badge */}
            <span style={{
              fontSize: 10, fontWeight: 600, letterSpacing: '0.08em', textTransform: 'uppercase',
              padding: '2px 7px', borderRadius: 3,
              background: T.accentBg, color: T.accent,
            }}>
              Active
            </span>
          </div>
        </Card>

        {/* ── Recent uploads — source: span 2, repeat(6,1fr) grid ── */}
        <Card span={2}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 14 }}>
            <h3 style={{ fontFamily: T.serif, fontSize: 20, margin: 0, fontWeight: 400, color: T.ink }}>
              Recent uploads
            </h3>
            <Link href="/dashboard/media" style={{ fontSize: 12, color: T.inkMute, textDecoration: 'none', fontFamily: T.mono }}>
              View media →
            </Link>
          </div>
          {/* Source: repeat(6, 1fr), gap 8 */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(6, 1fr)', gap: 8 }}>
            {UPLOAD_LABELS.map((label, i) => (
              recentPhotos[i]?.url ? (
                <div key={label} style={{ aspectRatio: '1', borderRadius: 6, overflow: 'hidden', position: 'relative', border: `1px solid ${T.line}` }}>
                  <img src={recentPhotos[i].url} alt={label} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover' }} />
                </div>
              ) : (
                <Placeholder key={label} aspect="1 / 1" label={label} radius={6} />
              )
            ))}
          </div>
        </Card>

        {/* ── Activity — source: span 2 ── */}
        <Card span={2}>
          <h3 style={{ fontFamily: T.serif, fontSize: 20, margin: '0 0 14px', fontWeight: 400, color: T.ink }}>
            Activity
          </h3>
          {activityItems.map((a, i) => (
            <div key={i} style={{
              display: 'flex', gap: 12, padding: '8px 0',
              borderTop: i === 0 ? 'none' : `1px solid ${T.lineSoft}`,
              fontSize: 13,
            }}>
              {/* Source: mono font, fontSize 10.5, minWidth 60 */}
              <div style={{ fontFamily: T.mono, fontSize: 10.5, color: T.inkMute, minWidth: 60, paddingTop: 2, flexShrink: 0 }}>
                {a.when}
              </div>
              <div style={{ color: T.inkSoft, lineHeight: 1.45 }}>{a.text}</div>
            </div>
          ))}
        </Card>

      </div>
    </div>
  )
}
