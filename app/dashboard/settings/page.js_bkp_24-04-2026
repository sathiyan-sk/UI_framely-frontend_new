          )}

          {/* ── BRANDING TAB ── */}
          {tab === 'branding' && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>

              {/* Header */}
              <div style={glass({ padding: '20px 24px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' })}>
                <div>
                  <div style={{ fontSize: 16, fontWeight: 800, color: '#2d1b69' }}>🎨 Watermark & Branding</div>
                  <div style={{ fontSize: 12, color: '#9b89c4', marginTop: 2 }}>Logo applied to all new uploads. Existing photos are not affected.</div>
                </div>
                <button onClick={saveBranding} disabled={brandingSaving} style={{ padding: '10px 24px', borderRadius: 12, background: brandingSaved ? 'rgba(34,197,94,0.15)' : 'linear-gradient(135deg,#9b7fe8,#c084fc)', color: brandingSaved ? '#15803d' : '#fff', border: brandingSaved ? '1px solid rgba(34,197,94,0.3)' : 'none', fontSize: 13, fontWeight: 700, cursor: 'pointer', transition: 'all .2s' }}>
                  {brandingSaved ? '✓ Saved!' : brandingSaving ? 'Saving...' : 'Save Branding'}
                </button>
              </div>

              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1.4fr', gap: 16, alignItems: 'start' }}>

                {/* LEFT — Logo upload + controls */}
                <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>

                  {/* Logo upload */}
                  <div style={glass({ padding: '20px 22px' })}>
                    <div style={{ fontSize: 13, fontWeight: 800, color: '#2d1b69', marginBottom: 3 }}>Studio Logo</div>
                    <div style={{ fontSize: 11, color: '#9b89c4', marginBottom: 14 }}>PNG with transparent background recommended · Max 2MB</div>
                    <div onClick={() => logoInputRef.current?.click()}
                      style={{ width: '100%', aspectRatio: '3/2', borderRadius: 12, border: '2px dashed rgba(155,127,232,0.3)', background: 'rgba(155,127,232,0.03)', display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer', overflow: 'hidden', marginBottom: 10, transition: 'border .15s' }}
                      onMouseEnter={e => e.currentTarget.style.borderColor='#9b7fe8'}
                      onMouseLeave={e => e.currentTarget.style.borderColor='rgba(155,127,232,0.3)'}>
                      {logoPreview
                        ? <img src={logoPreview} alt="logo" style={{ maxWidth: '80%', maxHeight: '80%', objectFit: 'contain' }} />
                        : <div style={{ textAlign: 'center' }}>
                            <div style={{ fontSize: 28, marginBottom: 6 }}>🖼</div>
                            <div style={{ fontSize: 12, fontWeight: 600, color: '#7c3aed' }}>Click to upload logo</div>
                            <div style={{ fontSize: 10, color: '#9b89c4', marginTop: 2 }}>PNG, JPG, SVG, WebP</div>
                          </div>}
                    </div>
                    <input ref={logoInputRef} type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" onChange={handleLogoSelect} style={{ display: 'none' }} />
                    <div style={{ display: 'flex', gap: 8 }}>
                      <button onClick={() => logoInputRef.current?.click()} style={{ flex: 1, padding: '8px', borderRadius: 9, border: '1px solid rgba(155,127,232,0.25)', background: 'rgba(155,127,232,0.06)', fontSize: 12, fontWeight: 600, color: '#7c3aed', cursor: 'pointer' }}>
                        {logoPreview ? '↺ Change Logo' : '⬆ Upload Logo'}
                      </button>
                      {logoPreview && (
                        <button onClick={() => { setLogoPreview(null); setLogoFile(null); setBranding(b => ({ ...b, logo_url: null })) }}
                          style={{ padding: '8px 12px', borderRadius: 9, border: '1px solid rgba(239,68,68,0.2)', background: 'rgba(239,68,68,0.05)', fontSize: 12, color: '#dc2626', cursor: 'pointer', fontWeight: 600 }}>✕</button>
                      )}
                    </div>
                  </div>

                  {/* Enable toggle */}
                  <div style={glass({ padding: '16px 18px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', background: branding.watermark_enabled ? 'rgba(155,127,232,0.07)' : undefined, border: branding.watermark_enabled ? '1.5px solid rgba(155,127,232,0.3)' : undefined, transition: 'all .2s' })}>
                    <div>
                      <div style={{ fontSize: 13, fontWeight: 700, color: '#2d1b69', marginBottom: 2 }}>Enable Watermark</div>
                      <div style={{ fontSize: 11, color: '#9b89c4' }}>Apply to all new uploads</div>
                    </div>
                    <div onClick={() => setBranding(b => ({ ...b, watermark_enabled: !b.watermark_enabled }))}
                      style={{ width: 44, height: 24, borderRadius: 12, background: branding.watermark_enabled ? '#7c3aed' : '#d1d5db', position: 'relative', cursor: 'pointer', transition: 'background .2s', flexShrink: 0 }}>
                      <div style={{ position: 'absolute', top: 3, left: branding.watermark_enabled ? 23 : 3, width: 18, height: 18, borderRadius: '50%', background: '#fff', transition: 'left .2s', boxShadow: '0 1px 4px rgba(0,0,0,0.2)' }} />
                    </div>
                  </div>

                  {/* Controls */}
                  <div style={glass({ padding: '18px 20px', opacity: branding.watermark_enabled ? 1 : 0.45, pointerEvents: branding.watermark_enabled ? 'auto' : 'none', transition: 'opacity .2s' })}>
                    <div style={{ fontSize: 12, fontWeight: 700, color: '#2d1b69', marginBottom: 14 }}>Watermark Options</div>

                    {/* Size */}
                    <div style={{ marginBottom: 14 }}>
                      <label style={lbl}>Size</label>
                      <div style={{ display: 'flex', gap: 7 }}>
                        {['small','medium','large'].map(s => {
                          const active = branding.watermark_size === s
                          return (
                            <button key={s} onClick={() => setBranding(b => ({ ...b, watermark_size: s }))}
                              style={{ flex: 1, padding: '8px 0', borderRadius: 9, border: `1.5px solid ${active ? '#9b7fe8' : 'rgba(155,127,232,0.2)'}`, background: active ? 'rgba(155,127,232,0.1)' : 'rgba(255,255,255,0.6)', fontSize: 12, fontWeight: active ? 700 : 500, color: active ? '#7c3aed' : '#5b4a8a', cursor: 'pointer', textTransform: 'capitalize', transition: 'all .15s' }}>
                              {s}
                            </button>
                          )
                        })}
                      </div>
                    </div>

                    {/* Opacity */}
                    <div style={{ marginBottom: 14 }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
                        <label style={{ ...lbl, marginBottom: 0 }}>Opacity</label>
                        <span style={{ fontSize: 12, fontWeight: 700, color: '#7c3aed' }}>{branding.watermark_opacity}%</span>
                      </div>
                      <input type="range" min="10" max="100" value={branding.watermark_opacity}
                        onChange={e => setBranding(b => ({ ...b, watermark_opacity: Number(e.target.value) }))}
                        style={{ width: '100%', accentColor: '#7c3aed', cursor: 'pointer' }} />
                    </div>

                    {/* Margin X */}
                    <div style={{ marginBottom: 14 }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
                        <label style={{ ...lbl, marginBottom: 0 }}>Horizontal Margin</label>
                        <span style={{ fontSize: 12, fontWeight: 700, color: '#7c3aed' }}>{branding.watermark_margin_x}%</span>
                      </div>
                      <input type="range" min="0" max="20" value={branding.watermark_margin_x}
                        onChange={e => setBranding(b => ({ ...b, watermark_margin_x: Number(e.target.value) }))}
                        style={{ width: '100%', accentColor: '#7c3aed', cursor: 'pointer' }} />
                    </div>

                    {/* Margin Y */}
                    <div>
                      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
                        <label style={{ ...lbl, marginBottom: 0 }}>Vertical Margin</label>
                        <span style={{ fontSize: 12, fontWeight: 700, color: '#7c3aed' }}>{branding.watermark_margin_y}%</span>
                      </div>
                      <input type="range" min="0" max="20" value={branding.watermark_margin_y}
                        onChange={e => setBranding(b => ({ ...b, watermark_margin_y: Number(e.target.value) }))}
                        style={{ width: '100%', accentColor: '#7c3aed', cursor: 'pointer' }} />
                    </div>
                  </div>
                </div>

                {/* RIGHT — Position picker + Live preview */}
                <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>

                  {/* 9-position grid */}
                  <div style={glass({ padding: '18px 20px', opacity: branding.watermark_enabled ? 1 : 0.45, pointerEvents: branding.watermark_enabled ? 'auto' : 'none', transition: 'opacity .2s' })}>
                    <div style={{ fontSize: 12, fontWeight: 700, color: '#2d1b69', marginBottom: 14 }}>Watermark Position</div>
                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 8 }}>
                      {WM_POSITIONS.map(pos => {
                        const active = branding.watermark_position === pos.id
                        return (
                          <button key={pos.id} onClick={() => setBranding(b => ({ ...b, watermark_position: pos.id }))}
                            style={{ padding: '12px 8px', borderRadius: 10, border: `1.5px solid ${active ? '#7c3aed' : 'rgba(155,127,232,0.2)'}`, background: active ? '#7c3aed' : 'rgba(255,255,255,0.7)', cursor: 'pointer', transition: 'all .15s', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4 }}>
                            <div style={{ fontSize: 10, fontWeight: 700, color: active ? '#fff' : '#5b4a8a', textAlign: 'center', lineHeight: 1.3 }}>{pos.label}</div>
                          </button>
                        )
                      })}
                    </div>
                  </div>

                  {/* Live Preview */}
                  <WatermarkPreview branding={branding} logoPreview={logoPreview} />
                </div>
              </div>

              <div style={glass({ padding: '14px 18px', background: 'rgba(251,191,36,0.06)', border: '1px solid rgba(251,191,36,0.2)' })}>
                <div style={{ fontSize: 12, color: '#92400e', lineHeight: 1.7 }}>
                  ⚠ <strong>Note:</strong> Watermark applies to both thumbnail and original during upload processing. Only photos uploaded <strong>after</strong> enabling will have the watermark. Face detection runs on the clean image before watermarking — so AI recognition is not affected.
                </div>
              </div>
            </div>
          )}

          {/* ── PLAN TAB ── */}
          {tab === 'plan' && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
              {successMsg && <div style={glass({ padding: '12px 16px', background: 'rgba(34,197,94,0.1)', border: '1px solid rgba(34,197,94,0.3)', fontSize: 13, fontWeight: 600, color: '#15803d' })}>{successMsg}</div>}
              {errorMsg   && <div style={glass({ padding: '12px 16px', background: 'rgba(239,68,68,0.08)', border: '1px solid rgba(239,68,68,0.2)', fontSize: 13, color: '#dc2626' })}>{errorMsg}</div>}

              <div style={glass({ padding: '24px 26px', border: '2px solid ' + curPlan.border })}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 20 }}>
                  <div>
                    <div style={{ fontSize: 11, fontWeight: 700, color: '#9b89c4', textTransform: 'uppercase', letterSpacing: '.07em', marginBottom: 5 }}>Active Plan</div>
                    <div style={{ fontSize: 26, fontWeight: 900, color: curPlan.color, marginBottom: 3 }}>{curPlan.name}</div>
                    <span style={{ fontSize: 10, fontWeight: 800, padding: '3px 10px', borderRadius: 20, background: curPlan.color, color: '#fff' }}>
                      {planData?.current_plan === 'starter' ? 'Free Forever' : 'Active'}
                    </span>
                  </div>
                  <div style={{ textAlign: 'right' }}>
                    <div style={{ fontSize: 32, fontWeight: 900, color: curPlan.color }}>{curPlan.price === 0 ? 'Free' : `Rs. ${curPlan.priceLabel}`}</div>
                    {curPlan.price > 0 && <div style={{ fontSize: 11, color: '#9b89c4' }}>per month</div>}
                  </div>
                </div>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 18 }}>
                  {[
                    { label: 'Photos Used', val: `${planData?.photos_used || 0} / ${planData?.photos_limit || 1000}`, pct },
                    { label: 'Storage',     val: `${gb} GB / ${curPlan.storage}`, pct: Math.min((parseFloat(gb) / curPlan.storageNum) * 100, 100) },
                  ].map(s => (
                    <div key={s.label}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 7 }}>
                        <span style={{ fontSize: 12, fontWeight: 600, color: '#5b4a8a' }}>{s.label}</span>
                        <span style={{ fontSize: 12, fontWeight: 700, color: '#2d1b69' }}>{s.val}</span>
                      </div>
                      <div style={{ height: 7, background: 'rgba(155,127,232,0.12)', borderRadius: 7, overflow: 'hidden' }}>
                        <div style={{ height: 7, width: s.pct + '%', background: s.pct > 80 ? 'linear-gradient(90deg,#ef4444,#f97316)' : `linear-gradient(90deg,${curPlan.color},#c084fc)`, borderRadius: 7 }} />
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 14 }}>
                {PLANS.map(plan => {
                  const isCurrent = planData?.current_plan === plan.key
                  return (
                    <div key={plan.key} style={glass({ padding: '20px', border: isCurrent ? `2px solid ${plan.color}` : '1px solid rgba(255,255,255,0.8)', position: 'relative' })}>
                      {plan.badge && !isCurrent && <div style={{ position: 'absolute', top: -10, left: '50%', transform: 'translateX(-50%)', fontSize: 10, fontWeight: 800, padding: '3px 10px', borderRadius: 20, background: plan.color, color: '#fff', whiteSpace: 'nowrap' }}>{plan.badge}</div>}
                      {isCurrent && <div style={{ position: 'absolute', top: 10, right: 10, fontSize: 10, fontWeight: 800, padding: '2px 8px', borderRadius: 20, background: plan.bg, color: plan.color, border: '1px solid ' + plan.border }}>Current</div>}
                      <div style={{ fontSize: 15, fontWeight: 800, color: plan.color, marginBottom: 3 }}>{plan.name}</div>
                      <div style={{ fontSize: 26, fontWeight: 900, color: '#2d1b69', marginBottom: 2 }}>{plan.price === 0 ? 'Free' : `Rs.${plan.priceLabel}`}</div>
                      <div style={{ fontSize: 11, color: '#9b89c4', marginBottom: 14 }}>{plan.price === 0 ? 'forever free' : 'per month'}</div>
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 7, marginBottom: 16 }}>
                        {plan.features.map((f, i) => (
                          <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 7 }}>
                            <span style={{ width: 14, height: 14, borderRadius: '50%', background: plan.bg, border: '1px solid ' + plan.border, display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 8, fontWeight: 900, color: plan.color, flexShrink: 0 }}>✓</span>
                            <span style={{ fontSize: 11, color: '#5b4a8a' }}>{f}</span>
                          </div>
                        ))}
                      </div>
                      {isCurrent
                        ? <div style={{ padding: '9px', borderRadius: 10, background: plan.bg, border: '1px solid ' + plan.border, fontSize: 12, fontWeight: 700, color: plan.color, textAlign: 'center' }}>Active Plan</div>
                        : plan.price === 0
                        ? <div style={{ padding: '9px', borderRadius: 10, background: 'rgba(107,114,128,0.06)', fontSize: 11, color: '#9b89c4', textAlign: 'center' }}>Free tier</div>
                        : <button onClick={() => upgrade(plan.key)} disabled={!!payLoading} style={{ width: '100%', padding: '10px', borderRadius: 10, background: payLoading === plan.key ? 'rgba(155,127,232,0.4)' : `linear-gradient(135deg,${plan.color},#c084fc)`, color: '#fff', border: 'none', fontSize: 12, fontWeight: 700, cursor: payLoading ? 'not-allowed' : 'pointer' }}>
                            {payLoading === plan.key ? 'Processing...' : `Upgrade to ${plan.name}`}
                          </button>
                      }
                    </div>
                  )
                })}
              </div>
            </div>
          )}

          {/* ── BILLING TAB ── */}
          {tab === 'billing' && (
            <div style={glass({ padding: '32px', textAlign: 'center' })}>
              <div style={{ fontSize: 36, marginBottom: 12 }}>🧾</div>
              <div style={{ fontSize: 15, fontWeight: 700, color: '#2d1b69', marginBottom: 6 }}>No invoices yet</div>
              <div style={{ fontSize: 13, color: '#9b89c4' }}>Your payment history will appear here</div>
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
