// ─── ZIP Download Modal ───────────────────────────────────────────────────────
function ZipDownloadModal({ stage, total, onClose }) {
  const stages = [
    { key: 'collecting',  icon: '📂', label: 'Collecting your photos',  sub: `Gathering ${total} photos from the cloud` },
    { key: 'compressing', icon: '🗜️', label: 'Preparing download',       sub: 'Getting your photos ready...' },
    { key: 'downloading', icon: '⬇️', label: 'Downloading',              sub: 'Your download has started — check your browser download bar' },
    { key: 'done',        icon: '✅', label: 'Download started!',         sub: 'Your ZIP file is downloading. Check your downloads folder.' },
  ]
  const currentIdx = stages.findIndex(s => s.key === stage)
  const progress = stage === 'done' ? 100 : stage === 'downloading' ? 70 : stage === 'compressing' ? 35 : 10

  return (
    <div style={{ position: 'fixed', inset: 0, zIndex: 300, display: 'flex', alignItems: 'center', justifyContent: 'center', background: 'rgba(13,13,26,0.85)', backdropFilter: 'blur(20px)', fontFamily: "'Inter',system-ui,sans-serif", padding: '16px' }}>
      <style>{ANIM}</style>
      <div style={{ background: 'rgba(255,255,255,0.96)', borderRadius: 28, padding: '28px 24px', maxWidth: 420, width: '100%', boxShadow: '0 32px 80px rgba(45,27,105,0.25)', textAlign: 'center' }}>
        <div style={{ fontSize: 48, marginBottom: 12, animation: stage !== 'done' ? 'zipBounce 1.2s ease-in-out infinite' : 'zoomIn .3s ease' }}>
          {stages[currentIdx]?.icon || '📦'}
        </div>
        <div style={{ fontSize: 17, fontWeight: 800, color: '#2d1b69', marginBottom: 6 }}>{stages[currentIdx]?.label}</div>
        <div style={{ fontSize: 12, color: '#9b89c4', marginBottom: 20, lineHeight: 1.5 }}>{stages[currentIdx]?.sub}</div>
        <div style={{ height: 6, background: 'rgba(155,127,232,0.12)', borderRadius: 6, overflow: 'hidden', marginBottom: 16 }}>
          <div style={{ height: '100%', width: `${progress}%`, background: 'linear-gradient(90deg,#9b7fe8,#c084fc)', borderRadius: 6, transition: 'width 0.8s cubic-bezier(.4,0,.2,1)' }} />
        </div>
        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 20 }}>
          {stages.map((s, i) => (
            <div key={s.key} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4, flex: 1 }}>
              <div style={{ width: 26, height: 26, borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 11, fontWeight: 700, background: i < currentIdx ? 'linear-gradient(135deg,#9b7fe8,#c084fc)' : i === currentIdx ? 'rgba(155,127,232,0.15)' : 'rgba(0,0,0,0.05)', color: i <= currentIdx ? (i < currentIdx ? '#fff' : '#7c3aed') : '#c4b5fd', border: i === currentIdx ? '2px solid #9b7fe8' : '2px solid transparent', transition: 'all .3s' }}>
                {i < currentIdx ? '✓' : i + 1}
              </div>
              <div style={{ fontSize: 9, color: i <= currentIdx ? '#7c3aed' : '#c4b5fd', fontWeight: 600, textAlign: 'center', lineHeight: 1.3 }}>
                {s.key === 'collecting' ? 'Collect' : s.key === 'compressing' ? 'Prepare' : s.key === 'downloading' ? 'Download' : 'Done'}
              </div>
            </div>
          ))}
        </div>
        {stage === 'downloading' && (
          <div style={{ marginBottom: 16, padding: '12px 14px', borderRadius: 12, background: 'rgba(34,197,94,0.08)', border: '1px solid rgba(34,197,94,0.2)' }}>
            <div style={{ fontSize: 12, color: '#15803d', fontWeight: 700 }}>✓ Download started! Look at your browser's download bar to track progress.</div>
          </div>
        )}
        {stage !== 'done' && stage !== 'downloading' && (
          <div style={{ display: 'inline-flex', alignItems: 'center', gap: 6, background: 'rgba(155,127,232,0.1)', border: '1px solid rgba(155,127,232,0.2)', padding: '6px 16px', borderRadius: 20 }}>
            <div style={{ width: 6, height: 6, borderRadius: '50%', background: '#9b7fe8', animation: 'pulse 1.5s ease infinite' }} />
            <span style={{ fontSize: 12, fontWeight: 700, color: '#7c3aed' }}>{total} photos</span>
          </div>
        )}
        {(stage === 'done' || stage === 'downloading') && (
          <button onClick={onClose} style={{ padding: '12px 32px', borderRadius: 14, background: 'linear-gradient(135deg,#9b7fe8,#c084fc)', color: '#fff', border: 'none', fontSize: 14, fontWeight: 700, cursor: 'pointer', boxShadow: '0 6px 20px rgba(155,127,232,0.4)', marginTop: stage === 'downloading' ? 8 : 0 }}>
            ✓ Done
          </button>
        )}
      </div>
    </div>
  )
}

