        {selected && <span style={{ color: '#fff', fontSize: 12, fontWeight: 900 }}>✓</span>}
      </div>
    </div>
  )
}

// ─── Page 3: Gallery ──────────────────────────────────────────────────────────
function GalleryPage({ photos, guestName, onFaceSearch, searching, slug, event }) {
  const [selected,    setSelected]    = useState(new Set())
  const [fullView,    setFullView]    = useState(null)
  const [fullViewIdx, setFullViewIdx] = useState(0)
  const [visible,     setVisible]     = useState(false)
  const [showConfirm, setShowConfirm] = useState(false)
  const [zipStage,    setZipStage]    = useState(null)
  const [zipTotal,    setZipTotal]    = useState(0)

  useEffect(() => { setTimeout(() => setVisible(true), 80) }, [])

  function toggle(id)  { setSelected(prev => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n }) }
  function selectAll() { setSelected(new Set(photos.map(p => p.photo_id))) }
  function clearSel()  { setSelected(new Set()) }

  async function downloadOne(url, name) {
    const filename = name || url.split('/').pop() || 'photo.jpg'
    const proxyUrl = `${API_URL}/search/download?url=${encodeURIComponent(url)}&filename=${encodeURIComponent(filename)}`
    const a = document.createElement('a')
    a.href = proxyUrl; a.download = filename
    document.body.appendChild(a); a.click(); document.body.removeChild(a)
  }

  function handleDownloadClick() { if (selected.size === 0) return; setShowConfirm(true) }

  async function performZipDownload() {
    setShowConfirm(false)
    const photoIds = Array.from(selected)
    setZipTotal(photoIds.length)
    setZipStage('collecting')
    try {
      await new Promise(r => setTimeout(r, 300))
      setZipStage('compressing')
      const res = await fetch(`${API_URL}/search/${slug}/prepare-zip`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(photoIds)
      })
      if (!res.ok) throw new Error(`Server error: ${res.status}`)
      const { token } = await res.json()
      setZipStage('downloading')
      window.location.href = `${API_URL}/search/${slug}/download-zip?token=${encodeURIComponent(token)}`
      await new Promise(r => setTimeout(r, 2500))
      setZipStage('done')
      clearSel()
    } catch (error) {
      console.error('Download error:', error)
      setZipStage(null)
      alert(`Download failed: ${error.message}. Please try again.`)
    }
  }

  function openModal(photo, idx) { setFullView(photo); setFullViewIdx(idx) }
  function prevPhoto() { const i = Math.max(0, fullViewIdx - 1); setFullViewIdx(i); setFullView(photos[i]) }
  function nextPhoto() { const i = Math.min(photos.length - 1, fullViewIdx + 1); setFullViewIdx(i); setFullView(photos[i]) }

  return (
    <div style={{ minHeight: '100vh', background: 'linear-gradient(135deg,#ddd6fe 0%,#e9d5ff 20%,#fbcfe8 50%,#fde68a 80%,#ddd6fe 100%)', fontFamily: "'Inter',system-ui,sans-serif", position: 'relative' }}>
      <style>{ANIM}</style>
      <div style={{ position: 'fixed', width: 300, height: 300, borderRadius: '50%', background: '#c4b5fd', filter: 'blur(90px)', opacity: .22, top: -80, left: -60, pointerEvents: 'none', zIndex: 0 }} />
      <div style={{ position: 'fixed', width: 280, height: 280, borderRadius: '50%', background: '#fbcfe8', filter: 'blur(80px)', opacity: .18, bottom: -60, right: -40, pointerEvents: 'none', zIndex: 0 }} />
      {showConfirm && <DownloadConfirmModal count={selected.size} onDownload={performZipDownload} onCancel={() => setShowConfirm(false)} />}
      {zipStage && <ZipDownloadModal stage={zipStage} total={zipTotal} onClose={() => setZipStage(null)} />}
      <div style={{ position: 'relative', zIndex: 1, opacity: visible ? 1 : 0, transform: visible ? 'translateY(0)' : 'translateY(20px)', transition: 'all .5s cubic-bezier(.4,0,.2,1)' }}>
        <div style={{ position: 'sticky', top: 0, zIndex: 20, background: 'rgba(255,255,255,0.88)', backdropFilter: 'blur(18px)', WebkitBackdropFilter: 'blur(18px)', borderBottom: '1px solid rgba(155,127,232,0.1)', padding: '0 12px' }}>
          <div style={{ maxWidth: 1200, margin: '0 auto', minHeight: 54, display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 8, padding: '8px 0' }}>
            <div style={{ width: 30, height: 30, borderRadius: 10, background: 'linear-gradient(135deg,#9b7fe8,#c084fc)', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', fontWeight: 800, fontSize: 13, flexShrink: 0 }}>P</div>
            <span style={{ fontSize: 13, fontWeight: 700, color: '#2d1b69', flex: 1, minWidth: 60 }}>Framely</span>
            {selected.size > 0 && (
              <div style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '4px 10px', background: 'rgba(155,127,232,0.1)', border: '1px solid rgba(155,127,232,0.2)', borderRadius: 20, animation: 'zoomIn .2s ease', flexShrink: 0 }}>
                <span style={{ fontSize: 11, fontWeight: 700, color: '#7c3aed' }}>{selected.size} selected</span>
                <button onClick={handleDownloadClick} style={{ padding: '3px 10px', borderRadius: 8, background: 'linear-gradient(135deg,#9b7fe8,#c084fc)', color: '#fff', border: 'none', fontSize: 11, fontWeight: 700, cursor: 'pointer' }}>⬇ ZIP</button>
                <button onClick={clearSel} style={{ padding: '3px 8px', borderRadius: 8, background: 'rgba(255,255,255,0.6)', color: '#9b89c4', border: '1px solid rgba(155,127,232,0.2)', fontSize: 11, cursor: 'pointer' }}>✕</button>
              </div>
