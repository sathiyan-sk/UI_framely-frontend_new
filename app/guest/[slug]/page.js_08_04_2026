  const isLarge = index % 5 === 0
  return (
    <div onMouseEnter={() => setHovered(true)} onMouseLeave={() => setHovered(false)} onDoubleClick={onFullView}
      style={{ gridColumn: isLarge ? 'span 2' : 'span 1', position: 'relative', borderRadius: 14, overflow: 'hidden', border: `2px solid ${selected ? '#9b7fe8' : 'transparent'}`, boxShadow: selected ? '0 0 0 3px rgba(155,127,232,0.25)' : hovered ? '0 16px 40px rgba(155,127,232,0.2)' : '0 4px 16px rgba(0,0,0,0.07)', transition: 'all .22s cubic-bezier(.4,0,.2,1)', transform: hovered ? 'translateY(-2px)' : 'translateY(0)', cursor: 'pointer', aspectRatio: isLarge ? '16/9' : '1/1', animation: `slideUp .4s ease ${Math.min(index * 0.05, 0.5)}s both` }}>
